# Every variable the app reads is validated at server start by src/lib/env.ts. A
# missing or malformed one stops the server with the full list of problems (names
# only, never values). Empty values count as unset. `next build` needs only NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY.

# Database (required)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/skill_dating?schema=public"

# Auth (Clerk)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY (pk_...) and CLERK_SECRET_KEY (sk_...) are
# required. They come from the Clerk dashboard (API keys). The webhook secret
# (whsec_...) comes from the webhook endpoint you create for /api/webhooks/clerk
# (Signing secret); it is optional in development and required in production.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
CLERK_WEBHOOK_SECRET=""
# Optional, comma separated origins allowed to mint session tokens, e.g.
# "https://app.example.com". Unset skips the authorized-party check.
CLERK_AUTHORIZED_PARTIES=""

# Sign-in providers (Google, GitHub, ...) are configured in the Clerk dashboard.
# The integration suite also reads CLERK_SECRET_KEY from here and refuses a key
# that is not a development (sk_test_) key.

# Infrastructure. Each provider is optional in development and test, where an
# in-memory stand-in is used (per process, nothing shared). In production every
# one is required, because the stand-ins cannot work across several instances.
# "Production" is VERCEL_ENV=production, or NODE_ENV=production without VERCEL_ENV.
# A Vercel preview (VERCEL_ENV=preview, set by Vercel itself) may leave them unset
# and starts with a warning. Each credential pair must be set together.

# Cache, rate limits, leaderboards, counters, presence: Upstash Redis (REST API).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Background jobs: Inngest (served at /api/inngest).
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# Realtime: Ably. The key has the form appId.keyId:secret. It is only ever used on
# the server; browsers receive short-lived tokens from /api/realtime/token.
ABLY_API_KEY=""

# Platform. All optional; each has a safe default.

# Plan limits (src/lib/entitlements.ts). "false" (default): every feature is open to
# everyone and only the hard safety ceilings apply. "true": the limits of each user's
# plan apply (FREE, PRO, CREW_PRO, ORG). Only "true" or "false" are accepted.
ENTITLEMENTS_ENFORCED="false"

# Product analytics. Events are always stored in the ProductEvent table; with a PostHog
# project API key (phc_...) they are also forwarded to PostHog. The host is only needed
# for a region or instance other than the default US cloud.
POSTHOG_KEY=""
POSTHOG_HOST="https://us.i.posthog.com"

# Error reporting. With a Sentry DSN, errors logged at error level are sent to Sentry.
# Without one they are only written to the log.
SENTRY_DSN=""

# Structured logs (JSON lines on stdout): debug, info, warn, error or silent.
# Default: info (warn under test).
LOG_LEVEL=""

# Whether the database client prints every query while NODE_ENV is development: on (default) or off.
# Scripts such as `npm run postdeploy` turn it off for themselves.
PRISMA_QUERY_LOG=""

# The settings below are not read by the application yet.

# Email
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="noreply@skilldating.app"

# File Upload
UPLOAD_DIR="./public/uploads"
MAX_FILE_SIZE="5242880"

# AI
OPENAI_API_KEY=""

# Feature Flags
ENABLE_HACKATHON_MODE="true"
ENABLE_AI_TEAM_BUILDER="true"
ENABLE_DATING_MODE="false"
# Rate limiting: how many reverse proxies you run in front of the app, i.e. how
# many entries at the right end of X-Forwarded-For to trust for the client
# address.
#   0 (default)  X-Forwarded-For is ignored entirely. Every signed-out caller
#                then shares ONE rate-limit bucket. Fine for local development,
#                not for a public deployment.
#   1            One trusted proxy or load balancer in front: the address it
#                appended (the rightmost entry) identifies the caller.
#   N            N trusted proxies; the Nth entry from the right is used.
# Never set it higher than the proxies you actually run: everything left of the
# trusted entries can be forged by the client. Signed-in traffic is limited per
# user and does not depend on this setting.
TRUSTED_PROXY_HOPS="0"
