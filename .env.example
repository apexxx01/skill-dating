# Every variable the app reads is validated at server start by src/lib/env.ts. A
# missing or malformed one stops the server with the full list of problems (names
# only, never values). Empty values count as unset. `next build` needs only NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY.

# Database (required)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/skill_dating?schema=public"

# Auth (Clerk)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY (pk_...) and CLERK_SECRET_KEY (sk_...) are
# required. They come from the Clerk dashboard (API keys). The webhook secret
# (whsec_...) comes from the webhook endpoint you create for /api/webhooks/clerk
# (Signing secret); it is optional in development and required in production.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
CLERK_WEBHOOK_SECRET=""
# Optional, comma separated origins allowed to mint session tokens, e.g.
# "https://app.example.com". Unset skips the authorized-party check.
CLERK_AUTHORIZED_PARTIES=""

# Sign-in providers (Google, GitHub, ...) are configured in the Clerk dashboard.
# The integration suite also reads CLERK_SECRET_KEY from here and refuses a key
# that is not a development (sk_test_) key.

# Infrastructure. Each provider is optional in development and test, where an
# in-memory stand-in is used (per process, nothing shared). In production every
# one is required, because the stand-ins cannot work across several instances.
# "Production" is VERCEL_ENV=production, or NODE_ENV=production without VERCEL_ENV.
# A Vercel preview (VERCEL_ENV=preview, set by Vercel itself) may leave them unset
# and starts with a warning. Each credential pair must be set together.

# Cache, rate limits, leaderboards, counters, presence: Upstash Redis (REST API).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Background jobs: Inngest (served at /api/inngest).
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# Realtime: Ably. The key has the form appId.keyId:secret. It is only ever used on
# the server; browsers receive short-lived tokens from /api/realtime/token.
ABLY_API_KEY=""

# Object storage for uploads (post media, romance photos): any S3-compatible store (AWS S3, Cloudflare R2, MinIO), addressed path-style as
# <endpoint>/<bucket>/<key>. Optional: without these, development keeps uploads in memory (PUT /api/media/dev-upload/...) and production refuses them
# with 503 STORAGE_UNAVAILABLE. The four must be set together. Browsers upload straight to the bucket with a presigned URL, so the bucket needs a CORS rule
# that allows PUT from the app's origin with the Content-Type header.
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_REGION="auto"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
# Optional: where objects are served publicly (a CDN, or the bucket's public domain). Without it every read is a short-lived signed URL.
STORAGE_PUBLIC_BASE_URL=""

# Platform. All optional; each has a safe default.

# Whether finishing onboarding needs a date of birth (docs/SAFETY.md: under 16 is refused, 16 and 17 are minors, 18+ may use everything). "true" (default) or "false".
# Set "false" only while a deploy reaches people before the onboarding screen asks for the date; the age rules still apply to anyone who has given one.
BIRTH_DATE_REQUIRED="true"

# Plan limits (src/lib/entitlements.ts). "false" (default): every feature is open to
# everyone, except that scarcity is the product in matching: 3 daily drops and 5 daily sparks
# for everybody (the FREE numbers), with only the hard safety ceilings above that. "true": the
# limits of each user's plan apply (FREE, PRO, CREW_PRO, ORG). Only "true" or "false" are accepted.
ENTITLEMENTS_ENFORCED="false"

# Product analytics. Events are always stored in the ProductEvent table; with a PostHog
# project API key (phc_...) they are also forwarded to PostHog. The host is only needed
# for a region or instance other than the default US cloud.
POSTHOG_KEY=""
POSTHOG_HOST="https://us.i.posthog.com"

# Error reporting. With a Sentry DSN the Sentry SDK reports unhandled errors (server, edge and browser) and errors logged at error level, with personal data
# scrubbed and every event tagged with the release. Without one nothing is sent and errors are only written to the log.
SENTRY_DSN=""
# Share of requests traced, 0 to 1 (default 0.05). Errors are always reported; traces are sampled.
SENTRY_TRACES_SAMPLE_RATE="0.05"
# The release name. Defaults to the commit Vercel built (VERCEL_GIT_COMMIT_SHA).
SENTRY_RELEASE=""

# Where the app is served, without a trailing slash. Used for the absolute links in emails and share cards. Required with RESEND_API_KEY.
APP_URL=""

# Email (notifications and digests). With a Resend key (re_...) and a sender they are sent by email; without them an in-memory outbox keeps what would have been
# sent (development and tests). EMAIL_FROM is "Name <address@domain>" on a domain verified in Resend. RESEND_WEBHOOK_SECRET (whsec_...) is the signing secret of the
# endpoint created in Resend for /api/webhooks/email, which marks bounced and complained addresses as undeliverable (without it the webhook answers 503).
RESEND_API_KEY=""
EMAIL_FROM=""
RESEND_WEBHOOK_SECRET=""
# Signs the unsubscribe links in emails: 32 or more random characters (openssl rand -base64 48). Without it the key is derived from CLERK_SECRET_KEY, so rotating
# that key breaks the links in mail already sent: set it wherever the mail is real.
NOTIFICATION_SIGNING_SECRET=""

# Web push: a VAPID key pair (npx web-push generate-vapid-keys) and a contact. Without them an in-memory stand-in records what would have been pushed.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:ops@example.com"

# Structured logs (JSON lines on stdout): debug, info, warn, error or silent.
# Default: info (warn under test).
LOG_LEVEL=""

# Whether the database client prints every query while NODE_ENV is development: on (default) or off.
# Scripts such as `npm run postdeploy` turn it off for themselves.
PRISMA_QUERY_LOG=""

# The settings below are not read by the application yet.

# File Upload
UPLOAD_DIR="./public/uploads"
MAX_FILE_SIZE="5242880"

# AI
OPENAI_API_KEY=""

# Feature Flags
ENABLE_HACKATHON_MODE="true"
ENABLE_AI_TEAM_BUILDER="true"
ENABLE_DATING_MODE="false"
# Rate limiting: how many reverse proxies you run in front of the app, i.e. how
# many entries at the right end of X-Forwarded-For to trust for the client
# address.
#   0 (default)  X-Forwarded-For is ignored entirely. Every signed-out caller
#                then shares ONE rate-limit bucket. Fine for local development,
#                not for a public deployment.
#   1            One trusted proxy or load balancer in front: the address it
#                appended (the rightmost entry) identifies the caller.
#   N            N trusted proxies; the Nth entry from the right is used.
# Never set it higher than the proxies you actually run: everything left of the
# trusted entries can be forged by the client. Signed-in traffic is limited per
# user and does not depend on this setting.
TRUSTED_PROXY_HOPS="0"
