# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/skill_dating?schema=public"

# Auth
NEXTAUTH_SECRET="your-super-secret-key-change-in-production"
# Do NOT set NEXTAUTH_URL with next-auth@5.0.0-beta.32 + next@14.1.0: it
# crashes every /api/auth/* route (see comment in .env.local). Leave unset;
# v5 infers the request URL itself.

# OAuth Providers
GITHUB_ID=""
GITHUB_SECRET=""
GOOGLE_ID=""
GOOGLE_SECRET=""
DISCORD_ID=""
DISCORD_SECRET=""

# Email
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="noreply@skilldating.app"

# Real-time
SOCKET_IO_URL="http://localhost:3001"

# File Upload
UPLOAD_DIR="./public/uploads"
MAX_FILE_SIZE="5242880"

# AI
OPENAI_API_KEY=""

# Analytics
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# Feature Flags
ENABLE_HACKATHON_MODE="true"
ENABLE_AI_TEAM_BUILDER="true"
ENABLE_DATING_MODE="false"
# Rate limiting: number of reverse-proxy hops you control in front of the app.
# 0 (default) ignores X-Forwarded-For entirely, so IP-keyed limits share one
# bucket; set to 1 behind a single trusted proxy/load balancer. Never set it
# higher than the proxies you actually run - clients can forge the left side
# of X-Forwarded-For.
TRUSTED_PROXY_HOPS="0"
