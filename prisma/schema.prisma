generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum VerificationLevel {
  NONE
  EMAIL
  PHONE
  GITHUB
  PORTFOLIO
  ORGANIZATION
  IDENTITY
}

enum ConnectionType {
  TEAMMATE
  COLLABORATOR
  MENTOR
  FRIEND
  NETWORK
  DATING
}

enum ProjectStatus {
  IDEA
  PLANNING
  BUILDING
  TESTING
  SHIPPED
  ARCHIVED
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
}

enum TeamApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum HackathonStatus {
  UPCOMING
  ACTIVE
  ENDED
  CANCELLED
}

enum HackathonParticipantStatus {
  REGISTERED
  TEAM_FORMED
  SUBMITTED
  WITHDRAWN
}

enum ChallengeCategory {
  CODING
  AI
  DESIGN
  PRODUCT
  LOGIC
  CYBERSECURITY
  ENTREPRENEURSHIP
  COMMUNICATION
  PROBLEM_SOLVING
}

enum ChallengeDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum NotificationType {
  NEW_MESSAGE
  TEAM_INVITATION
  JOIN_REQUEST
  HACKATHON_REMINDER
  PROJECT_UPDATE
  ACHIEVEMENT
  CHALLENGE_COMPLETION
  CONNECTION
  MENTION
  APPLICATION_RESPONSE
  SYSTEM
}

enum ReportReason {
  SPAM
  HARASSMENT
  INAPPROPRIATE_CONTENT
  FAKE_PROFILE
  SCAM
  COPYRIGHT
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  DISMISSED
}

model User {
  id              String             @id @default(cuid())
  email           String             @unique
  emailVerified   DateTime?
  passwordHash    String?
  name            String?
  username        String             @unique
  image           String?
  bio             String?
  headline        String?
  location        String?
  timezone        String?
  availability    String?
  builderRole     String?
  website         String?
  githubUsername  String?            @unique
  twitterUsername String?            @unique
  linkedinUrl     String?
  role            UserRole           @default(USER)
  verificationLevel VerificationLevel @default(NONE)
  isEmailVerified Boolean            @default(false)
  isPhoneVerified Boolean            @default(false)
  githubConnected Boolean            @default(false)
  portfolioVerified Boolean          @default(false)
  organizationVerified Boolean       @default(false)
  identityVerified Boolean           @default(false)
  xp              Int                @default(0)
  rank            Int                @default(0)
  reputationScore Int                @default(0)
  lastActiveAt    DateTime           @default(now())
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  accounts        Account[]
  sessions        Session[]
  profile         Profile?
  skills          UserSkill[]
  skillEvidences  SkillEvidence[]
  projects        ProjectMember[]
  ownedProjects   Project[]          @relation("ProjectOwner")
  teams           TeamMember[]
  ownedTeams      Team[]             @relation("TeamOwner")
  teamApplications TeamApplication[]
  teamInvitationsSent TeamApplication[] @relation("TeamInvitationsSent")
  hackathons      HackathonParticipant[]
  hackathonTeams  HackathonTeamMember[]
  challenges      ChallengeAttempt[]
  achievements    UserAchievement[]
  xpEvents        XPEvent[]
  reputationEvents ReputationEvent[]
  sentConnections Connection[]       @relation("SentConnections")
  receivedConnections Connection[]  @relation("ReceivedConnections")
  conversations   ConversationMember[]
  messages        Message[]
  messageReactions MessageReaction[]
  messageReads    MessageRead[]
  notifications   Notification[]
  reports         Report[]           @relation("ReportsSubmitted")
  reportedReports Report[]           @relation("ReportsAgainst")
  moderationActions ModerationAction[]
  auditEvents     AuditEvent[]
  verifications   Verification[]
  currentBuild    CurrentBuild?
  projectUpdates  ProjectUpdate[]
  userQuests      UserQuest[]
  activities      Activity[]
  leaderboardEntries LeaderboardEntry[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline    String?
  bio         String?  @db.Text
  location    String?
  timezone    String?
  availability String?
  builderRole String?
  website     String?
  githubUrl   String?
  portfolioUrl String?
  linkedinUrl String?
  twitterUrl  String?
  showEmail   Boolean  @default(false)
  showLocation Boolean @default(true)
  showAvailability Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Skill {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  category    String
  subcategory String?
  description String?  @db.Text
  icon        String?
  color       String?
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userSkills    UserSkill[]
  skillEvidences SkillEvidence[]
}

model UserSkill {
  id          String   @id @default(cuid())
  userId      String
  skillId     String
  level       Int      @default(1) // 1-5
  isVerified  Boolean  @default(false)
  yearsExperience Float? @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
}

model SkillEvidence {
  id          String   @id @default(cuid())
  userId      String
  skillId     String
  type        String   // CHALLENGE, GITHUB_PROJECT, HACKATHON_PROJECT, CONTRIBUTION, PEER_ENDORSEMENT, PORTFOLIO, CERTIFICATION, CONNECTED_PROFILE
  title       String
  description String?  @db.Text
  url         String?
  metadata    Json?
  verifiedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)
}

model Project {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String?       @db.Text
  shortDesc   String?
  status      ProjectStatus @default(IDEA)
  ownerId     String
  hackathonId String?
  githubUrl   String?
  demoUrl     String?
  websiteUrl  String?
  thumbnail   String?
  isPublic    Boolean       @default(true)
  teamSize    Int           @default(1)
  maxTeamSize Int           @default(5)
  lookingFor  String[]      @default([])
  techStack   String[]      @default([])
  startedAt   DateTime?
  shippedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  owner       User            @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     ProjectMember[]
  hackathon   Hackathon?      @relation(fields: [hackathonId], references: [id], onDelete: SetNull)
  team        Team?
  updates     ProjectUpdate[]
  milestones  Milestone[]
  chat        Chat?
  conversation Conversation?
  activities  Activity[]
}

model ProjectMember {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  role      String   @default("MEMBER")
  joinedAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
}

model ProjectUpdate {
  id        String   @id @default(cuid())
  projectId String
  authorId  String
  title     String
  content   String   @db.Text
  type      String   @default("UPDATE") // UPDATE, MILESTONE, SHIPPED, ANNOUNCEMENT
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model Milestone {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  description String?  @db.Text
  dueDate     DateTime?
  completedAt DateTime?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Team {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String?  @db.Text
  projectId    String?  @unique
  hackathonId  String?
  ownerId      String
  maxSize      Int      @default(5)
  isRecruiting Boolean  @default(true)
  lookingFor   String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  owner           User                  @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members         TeamMember[]
  applications    TeamApplication[]
  project         Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  hackathon       Hackathon?            @relation(fields: [hackathonId], references: [id], onDelete: SetNull)
  hackathonTeams  HackathonTeam[]
  chat            Chat?
  conversation    Conversation?
}

model TeamMember {
  id        String   @id @default(cuid())
  userId    String
  teamId    String
  role      TeamRole @default(MEMBER)
  joinedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
}

model TeamApplication {
  id          String                 @id @default(cuid())
  userId      String
  teamId      String
  message     String?                @db.Text
  status      TeamApplicationStatus  @default(PENDING)
  // Null (the default) means this is a self-initiated application, reviewed
  // by the team owner/admin as before. Set means the OWNER invited this
  // user directly - the accept/decline authorization flips to the invitee
  // (userId), not the team, since they're the one being asked. Everything
  // else about the row (the unique[userId,teamId] constraint, the accept
  // transaction, the maxSize guard) is shared and unchanged either way.
  invitedById String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitedBy User? @relation("TeamInvitationsSent", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([userId, teamId])
}

model Hackathon {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  description String            @db.Text
  shortDesc   String?
  startDate   DateTime
  endDate     DateTime
  registrationDeadline DateTime?
  status      HackathonStatus   @default(UPCOMING)
  organizer   String?
  websiteUrl  String?
  prizePool   String?
  rules       String?           @db.Text
  technologies String[]         @default([])
  maxTeamSize Int               @default(5)
  minTeamSize Int               @default(1)
  location    String?           // ONLINE, HYBRID, or physical location
  isPublic    Boolean           @default(true)
  thumbnail   String?
  banner      String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  participants    HackathonParticipant[]
  hackathonTeams  HackathonTeam[]
  projects        Project[]
  teams           Team[]
  currentBuilds   CurrentBuild[]
  chat            Chat?
  conversation    Conversation?
}

model HackathonParticipant {
  id            String                    @id @default(cuid())
  userId        String
  hackathonId   String
  status        HackathonParticipantStatus @default(REGISTERED)
  teamId        String?
  registeredAt  DateTime                  @default(now())
  skills        String[]                  @default([])
  lookingFor    String[]                  @default([])

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  hackathon Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)

  @@unique([userId, hackathonId])
}

model HackathonTeam {
  id          String   @id @default(cuid())
  hackathonId String
  teamId      String   @unique
  name        String
  projectId   String?
  rank        Int?
  score       Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hackathon Hackathon       @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  team      Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  members   HackathonTeamMember[]
}

model HackathonTeamMember {
  id            String   @id @default(cuid())
  hackathonTeamId String
  userId        String
  role          String   @default("MEMBER")
  joinedAt      DateTime @default(now())

  hackathonTeam HackathonTeam @relation(fields: [hackathonTeamId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([hackathonTeamId, userId])
}

model Challenge {
  id          String             @id @default(cuid())
  title       String
  slug        String             @unique
  description String             @db.Text
  category    ChallengeCategory
  difficulty  ChallengeDifficulty
  xpReward    Int                @default(100)
  repoUrl     String?
  starterCode String?            @db.Text
  tests       Json?
  tags        String[]           @default([])
  isActive    Boolean            @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  attempts ChallengeAttempt[]
}

model ChallengeAttempt {
  id           String   @id @default(cuid())
  userId       String
  challengeId  String
  code         String?  @db.Text
  language     String?
  status       String   @default("PENDING") // PENDING, PASSED, FAILED, RUNNING
  score        Int?
  output       String?  @db.Text
  passedTests  Int      @default(0)
  totalTests   Int      @default(0)
  timeSpent    Int      @default(0) // seconds
  submittedAt  DateTime @default(now())
  completedAt  DateTime?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
}

model Achievement {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String   @db.Text
  icon        String?
  category    String
  xpReward    Int      @default(0)
  criteria    Json     // { type, conditions }
  isSecret    Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  earnedAt      DateTime @default(now())
  progress      Json?    // For tracking progress towards achievement

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

model XPEvent {
  id          String   @id @default(cuid())
  userId      String
  type        String   // CHALLENGE_COMPLETE, HACKATHON_JOIN, HACKATHON_WIN, PROJECT_SHIP, OSS_CONTRIBUTION, TEAM_HELP, MILESTONE_COMPLETE, ENDORSEMENT_RECEIVED, QUEST_COMPLETE
  amount      Int
  description String
  metadata    Json?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ReputationEvent {
  id          String   @id @default(cuid())
  userId      String
  type        String   // PROJECT_SHIPPED, HACKATHON_PLACEMENT, CHALLENGE_COMPLETE, OSS_CONTRIBUTION, TEAM_ENDORSEMENT, PEER_ENDORSEMENT, SKILL_VERIFIED
  amount      Int
  sourceId    String?  // Reference to project, hackathon, challenge, etc.
  sourceType  String?  // PROJECT, HACKATHON, CHALLENGE, USER
  description String
  metadata    Json?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Connection {
  id          String         @id @default(cuid())
  senderId    String
  receiverId  String
  type        ConnectionType @default(NETWORK)
  status      String         @default("PENDING") // PENDING, ACCEPTED, DECLINED, BLOCKED
  message     String?        @db.Text
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  sender   User @relation("SentConnections", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedConnections", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
}

model Conversation {
  id          String   @id @default(cuid())
  type        String   @default("DIRECT") // DIRECT, GROUP, PROJECT, TEAM, HACKATHON
  name        String?
  projectId   String?  @unique
  teamId      String?  @unique
  hackathonId String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     ConversationMember[]
  messages    Message[]
  chats       Chat[]
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  team        Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  hackathon   Hackathon?   @relation(fields: [hackathonId], references: [id], onDelete: SetNull)
}

model ConversationMember {
  id             String   @id @default(cuid())
  userId         String
  conversationId String
  role           String   @default("MEMBER") // MEMBER, ADMIN, OWNER
  joinedAt       DateTime @default(now())
  lastReadAt     DateTime?
  isMuted        Boolean  @default(false)
  isPinned       Boolean  @default(false)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([userId, conversationId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  content        String   @db.Text
  type           String   @default("TEXT") // TEXT, IMAGE, FILE, SYSTEM, CODE, LINK_PREVIEW
  replyToId      String?
  editedAt       DateTime?
  deletedAt      DateTime?
  metadata       Json?
  createdAt      DateTime @default(now())

  conversation Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User           @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo      Message?       @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]      @relation("MessageReplies")
  reactions    MessageReaction[]
  reads        MessageRead[]
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
}

model MessageRead {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  readAt    DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
}

model Chat {
  id          String   @id @default(cuid())
  type        String   // PROJECT, TEAM, HACKATHON
  projectId   String?  @unique
  teamId      String?  @unique
  hackathonId String?  @unique
  conversationId String @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  team        Team?        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  hackathon   Hackathon?   @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String           @db.Text
  link      String?
  metadata  Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Report {
  id          String       @id @default(cuid())
  reporterId  String
  reportedId  String
  reason      ReportReason
  description String?      @db.Text
  status      ReportStatus @default(PENDING)
  metadata    Json?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  reporter User @relation("ReportsSubmitted", fields: [reporterId], references: [id], onDelete: Cascade)
  reported User @relation("ReportsAgainst", fields: [reportedId], references: [id], onDelete: Cascade)
}

model ModerationAction {
  id          String   @id @default(cuid())
  moderatorId String
  targetId    String
  targetType  String   // USER, MESSAGE, PROJECT, TEAM, REPORT
  action      String   // WARN, SUSPEND, BAN, DELETE, LOCK, UNLOCK
  reason      String   @db.Text
  duration    Int?     // For temporary actions (in days)
  metadata    Json?
  createdAt   DateTime @default(now())

  moderator User @relation(fields: [moderatorId], references: [id], onDelete: Cascade)
}

model AuditEvent {
  id          String   @id @default(cuid())
  userId      String?
  action      String
  targetType  String
  targetId    String?
  oldValue    Json?
  newValue    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Verification {
  id          String   @id @default(cuid())
  userId      String
  type        String   // EMAIL, PHONE, GITHUB, PORTFOLIO, ORGANIZATION, IDENTITY
  status      String   @default("PENDING") // PENDING, VERIFIED, REJECTED, EXPIRED
  provider    String?
  providerId  String?
  metadata    Json?
  verifiedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CurrentBuild {
  id          String   @id @default(cuid())
  userId      String   @unique
  title       String
  description String?  @db.Text
  status      ProjectStatus @default(BUILDING)
  progress    Int      @default(0) // 0-100
  techStack   String[] @default([])
  teamSize    Int      @default(1)
  maxTeamSize Int      @default(5)
  rolesNeeded String[] @default([])
  hackathonId String?
  githubUrl   String?
  demoUrl     String?
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  hackathon Hackathon? @relation(fields: [hackathonId], references: [id])

  @@index([hackathonId])
}

model Quest {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String   @db.Text
  type        String   // WEEKLY, DAILY, SPECIAL
  criteria    Json     // { type, conditions }
  xpReward    Int      @default(0)
  achievementId String?
  startsAt    DateTime
  endsAt      DateTime
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userQuests UserQuest[]
}

model UserQuest {
  id        String   @id @default(cuid())
  userId    String
  questId   String
  progress  Json     // { completed: boolean, progress: number }
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest Quest @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@unique([userId, questId])
}

model Activity {
  id        String   @id @default(cuid())
  userId    String
  type      String   // PROJECT_SHIPPED, HACKATHON_JOINED, HACKATHON_WON, CHALLENGE_COMPLETED, TEAM_JOINED, ACHIEVEMENT_EARNED, OSS_RELEASED, MILESTONE_REACHED
  title     String
  description String? @db.Text
  link      String?
  metadata  Json?
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId String?
}

model Leaderboard {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  type        String   // GLOBAL, HACKATHON, TECHNICAL, SHIPPING, RISING, CHALLENGE
  period      String   // ALL_TIME, MONTHLY, WEEKLY, DAILY
  hackathonId String?
  criteria    Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entries LeaderboardEntry[]
}

model LeaderboardEntry {
  id           String   @id @default(cuid())
  leaderboardId String
  userId       String
  rank         Int
  score        Int
  metadata     Json?
  calculatedAt DateTime @default(now())

  leaderboard Leaderboard @relation(fields: [leaderboardId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([leaderboardId, userId])
}