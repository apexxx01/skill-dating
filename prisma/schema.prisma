generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum VerificationLevel {
  NONE
  EMAIL
  PHONE
  GITHUB
  PORTFOLIO
  ORGANIZATION
  IDENTITY
}

enum ConnectionType {
  TEAMMATE
  COLLABORATOR
  MENTOR
  FRIEND
  NETWORK
  DATING
}

enum ProjectStatus {
  IDEA
  PLANNING
  BUILDING
  TESTING
  SHIPPED
  ARCHIVED
}

// What a person can be looking for in the matching engine (src/lib/matching). MENTOR and MENTEE are the two sides of one
// relationship; the others pair with themselves. DATING is separate: it never mixes with the rest, in either direction.
enum MatchType {
  COFOUNDER
  HACKATHON_TEAMMATE
  COLLABORATOR
  MENTOR
  MENTEE
  DATING
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
}

enum TeamApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
  // An invitation nobody answered within its 48 hours (src/lib/squads/lifecycle.ts).
  EXPIRED
}

// The fixed role catalogue of a squad (docs/SQUADS.md): what an open slot asks for and what a member says they do on the team. OTHER carries a
// customLabel ("Smart contract developer").
enum SquadRole {
  FRONTEND
  BACKEND
  FULLSTACK
  MOBILE
  ML_AI
  DATA
  DEVOPS
  DESIGN_UI_UX
  PRODUCT
  PITCH_BUSINESS
  HARDWARE
  OTHER
}

enum SlotStatus {
  OPEN
  FILLED
}

// BUILDER: "Find my squad", for one requester. AUTO: the solo-pool auto-formation, for everybody who opted in.
enum SquadProposalKind {
  BUILDER
  AUTO
}

// A BUILDER proposal is OPEN until its requester sends the invitations (INVITED) or it EXPIRES. An AUTO proposal is PROPOSED to its members, then
// FORMED (enough accepted, the team exists) or FAILED.
enum SquadProposalStatus {
  OPEN
  INVITED
  PROPOSED
  FORMED
  FAILED
  EXPIRED
}

enum ProposalResponse {
  PENDING
  ACCEPTED
  DECLINED
}

// Where a hackathon lives: run here (NATIVE), or on another platform with this one as its team layer (EXTERNAL, docs/SQUADS.md).
enum HackathonSource {
  NATIVE
  EXTERNAL
}

enum HackathonPlatform {
  DEVFOLIO
  DEVPOST
  MLH
  UNSTOP
  LUMA
  OTHER
}

enum HackathonMode {
  ONLINE
  IN_PERSON
  HYBRID
}

// A commitment pledge: how a squad member will take part.
enum AttendanceMode {
  IN_PERSON
  REMOTE
}

// A peer review: did the teammate show up.
enum ShowedUp {
  YES
  PARTLY
  NO
}

// A looking-for-group post: a person looking for a squad, or a team looking for people.
enum LfgKind {
  PERSON
  TEAM
}

enum HackathonStatus {
  UPCOMING
  ACTIVE
  ENDED
  CANCELLED
}

enum HackathonParticipantStatus {
  REGISTERED
  TEAM_FORMED
  SUBMITTED
  WITHDRAWN
}

enum ChallengeCategory {
  CODING
  AI
  DESIGN
  PRODUCT
  LOGIC
  CYBERSECURITY
  ENTREPRENEURSHIP
  COMMUNICATION
  PROBLEM_SOLVING
}

enum ChallengeDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum NotificationType {
  NEW_MESSAGE
  TEAM_INVITATION
  JOIN_REQUEST
  HACKATHON_REMINDER
  PROJECT_UPDATE
  ACHIEVEMENT
  CHALLENGE_COMPLETION
  CONNECTION
  MENTION
  APPLICATION_RESPONSE
  SYSTEM
  MATCH
  // Social: props on a post, a comment or reply, a new follower, a post on a project the person watches (src/lib/notifications.ts coalesces them).
  PROPS
  COMMENT
  FOLLOW
  WATCH
  // Somebody sparked you: one per spark for a plan that shows who, one daily count for one that does not (src/lib/matching/spark-digest.ts).
  SPARK
}

enum ReportReason {
  SPAM
  HARASSMENT
  INAPPROPRIATE_CONTENT
  FAKE_PROFILE
  SCAM
  COPYRIGHT
  OTHER
  // A person asking for their own locked date of birth to be corrected (the report is filed against themselves; an admin decides).
  BIRTHDATE_CORRECTION
  // Pretending to be another person, an organisation or the platform. Its own priority (src/lib/moderation/priority.ts).
  IMPERSONATION
  // Anything that puts a minor at risk. Always first in the queue.
  MINOR_SAFETY
}

// What a report is about (src/lib/moderation/targets.ts). USER is the person; the others are one thing they made.
enum ReportTarget {
  USER
  MESSAGE
  SHIP_POST
  COMMENT
  SPARK
  ROMANCE_PROFILE
  LFG_POST
  IDEA
  EXTERNAL_HACKATHON
  // An upload the media scanner sent for review (src/lib/infra/media-moderation.ts).
  MEDIA
}

enum ReportSource {
  // Filed by a person.
  USER
  // Filed by the platform: a flagged message or post, a photo the scanner was unsure about.
  AUTOMATED
}

enum AppealStatus {
  PENDING
  // The action stands.
  UPHELD
  // The action is reversed.
  OVERTURNED
}

enum RestrictionKind {
  // Signed in but closed to everything but appeals, their own data and their account (src/lib/moderation/restrictions.ts).
  SUSPENDED
  BANNED
  // One feature closed, the rest open.
  ROMANCE
  MESSAGING
  POSTING
}

enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  DISMISSED
}

model User {
  id                   String            @id @default(cuid())
  // Clerk user id. Null for legacy rows (seeded demo users, accounts created
  // before the move to Clerk) until they are linked on a verified email.
  clerkId              String?           @unique
  email                String            @unique
  emailVerified        DateTime?
  passwordHash         String?
  name                 String?
  username             String            @unique
  // The username with every difference a reader would not notice folded away (src/lib/identity/confusables.ts): two people never share one, and
  // nobody gets a reserved name's. Not unique in the database, because names given before it existed may collide; new names are checked against it.
  usernameSkeleton     String?
  image                String?
  bio                  String?
  headline             String?
  location             String?
  timezone             String?
  availability         String?
  builderRole          String?
  website              String?
  githubUsername       String?           @unique
  twitterUsername      String?           @unique
  linkedinUrl          String?
  role                 UserRole          @default(USER)
  verificationLevel    VerificationLevel @default(NONE)
  isEmailVerified      Boolean           @default(false)
  isPhoneVerified      Boolean           @default(false)
  githubConnected      Boolean           @default(false)
  portfolioVerified    Boolean           @default(false)
  organizationVerified Boolean           @default(false)
  identityVerified     Boolean           @default(false)
  xp                   Int               @default(0)
  rank                 Int               @default(0)
  reputationScore      Int               @default(0)
  lastActiveAt         DateTime          @default(now())
  // PRIVATE. Only ever read to check that someone is 18 or older for DATING, and returned to nobody but the owner on
  // their own profile read (GET /api/users/me/profile). Set once and then locked. Wiped when the account is deleted.
  birthDate            DateTime?         @db.Date
  // Set when the person gave a date of birth that makes them younger than the platform minimum (src/lib/age-policy.ts). NOTHING else about it is
  // kept, not the date: the account is closed to everything but asking for a correction, and an admin correction (which clears this) is the only way back.
  birthDateRefusedAt   DateTime?
  // What the user wears: { title, frame, banner }, each the slug of a cosmetic they own (or absent).
  equipped             Json              @default("{}")
  // Streak (see src/lib/streaks.ts). A day counts when the user earned XP from an action of their
  // own that local day. lastStreakDay is that local date, "YYYY-MM-DD", in the user's time zone then.
  currentStreak        Int               @default(0)
  longestStreak        Int               @default(0)
  lastStreakDay        String?
  // Banked freezes, at most 2: a single missed day spends one instead of ending the streak.
  streakFreezes        Int               @default(0)
  // A freeze was spent during the current run (reset when a run starts over).
  streakFreezeUsed     Boolean           @default(false)
  // Set when the Clerk account is deleted. The row is kept and anonymised so
  // the content other people depend on survives (see docs/AUTH_MIGRATION.md).
  deletedAt            DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  accounts            Account[]
  sessions            Session[]
  profile             Profile?
  skills              UserSkill[]
  skillEvidences      SkillEvidence[]
  projects            ProjectMember[]
  ownedProjects       Project[]                @relation("ProjectOwner")
  teams               TeamMember[]
  ownedTeams          Team[]                   @relation("TeamOwner")
  teamApplications    TeamApplication[]
  teamInvitationsSent TeamApplication[]        @relation("TeamInvitationsSent")
  blocksMade          Block[]                  @relation("BlocksMade")
  blocksReceived      Block[]                  @relation("BlocksReceived")
  hackathons          HackathonParticipant[]
  hackathonTeams      HackathonTeamMember[]
  teamSlotsFilled     TeamSlot[]               @relation("TeamSlotsFilled")
  squadProposals      SquadProposal[]          @relation("SquadProposalsRequested")
  squadProposalSeats  SquadProposalMember[]
  lfgPosts            LfgPost[]
  hackathonsSubmitted Hackathon[]              @relation("HackathonsSubmitted")
  pledges             CommitmentPledge[]
  peerReviewsGiven    PeerReview[]             @relation("PeerReviewsGiven")
  peerReviewsReceived PeerReview[]             @relation("PeerReviewsReceived")
  reliability         UserReliability?
  checklistAssigned   TeamChecklistItem[]      @relation("ChecklistAssigned")
  checklistCreated    TeamChecklistItem[]      @relation("ChecklistCreated")
  teamIdeas           TeamIdea[]
  teamIdeaVotes       TeamIdeaVote[]
  challenges          ChallengeAttempt[]
  achievements        UserAchievement[]
  xpEvents            XPEvent[]
  reputationEvents    ReputationEvent[]
  sentConnections     Connection[]             @relation("SentConnections")
  receivedConnections Connection[]             @relation("ReceivedConnections")
  conversations       ConversationMember[]
  messages            Message[]
  messageReactions    MessageReaction[]
  messageReads        MessageRead[]
  notifications       Notification[]
  reports             Report[]                 @relation("ReportsSubmitted")
  reportedReports     Report[]                 @relation("ReportsAgainst")
  moderationActions   ModerationAction[]
  auditEvents         AuditEvent[]
  verifications       Verification[]
  currentBuild        CurrentBuild?
  projectUpdates      ProjectUpdate[]
  userQuests          UserQuest[]
  activities          Activity[]
  leaderboardEntries  LeaderboardEntry[]
  subscription        Subscription?
  productEvents       ProductEvent[]
  seasonStandings     SeasonStanding[]
  counters            UserCounter[]
  progressTicks       ProgressTick[]
  cosmetics           UserCosmetic[]
  matchingProfile     MatchingProfile?
  drops               Drop[]                   @relation("DropsReceived")
  dropsShown          Drop[]                   @relation("DropsShown")
  sparksSent          Spark[]                  @relation("SparksSent")
  sparksReceived      Spark[]                  @relation("SparksReceived")
  matchesAsA          Match[]                  @relation("MatchesAsA")
  matchesAsB          Match[]                  @relation("MatchesAsB")
  notificationPrefs   NotificationPreference[]
  mediaAssets         MediaAsset[]
  posts               ShipPost[]
  props               Prop[]
  comments            Comment[]
  following           Follow[]                 @relation("Following")
  followers           Follow[]                 @relation("Followers")
  watches             Watch[]
  romanceProfile      RomanceProfile?
  risk                UserRisk?
  dataExports         DataExport[]
  consents            ConsentRecord[]
  appeals             Appeal[]
  restrictions        UserRestriction[]
  mutesMade           Mute[]                   @relation("MutesMade")
  mutesReceived       Mute[]                   @relation("MutesReceived")
  romanceDrops        RomanceDrop[]            @relation("RomanceDropsReceived")
  romanceDropsShown   RomanceDrop[]            @relation("RomanceDropsShown")
  duosAsA             Duo[]                    @relation("DuoAsA")
  duosAsB             Duo[]                    @relation("DuoAsB")
  pushSubs            PushSubscription[]
  notifSettings       NotificationSettings?
  channelPrefs        ChannelPreference[]
  deliveries          NotificationDelivery[]
  inviteCode          InviteCode?              @relation("InviteOwner")
  inviteeOf           InviteRedemption?        @relation("InviteeOf")
  invitesMade         InviteRedemption[]       @relation("InviterOf")
  campusMembership    CampusMembership?
  campusVerification  CampusVerification?

  // "Users active in the last 30 days" is the denominator of every achievement's rarity.
  @@index([lastActiveAt])
  @@index([usernameSkeleton])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Who may start a direct conversation with a person (src/lib/privacy/settings.ts).
enum MessagePermission {
  EVERYONE
  // People they are connected with, matched with, or share a crew with.
  CONNECTIONS
  NOBODY
}

model Profile {
  id                   String            @id @default(cuid())
  userId               String            @unique
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline             String?
  bio                  String?           @db.Text
  location             String?
  timezone             String?
  availability         String?
  builderRole          String?
  website              String?
  githubUrl            String?
  portfolioUrl         String?
  linkedinUrl          String?
  twitterUrl           String?
  showEmail            Boolean           @default(false)
  showLocation         Boolean           @default(true)
  showAvailability     Boolean           @default(true)
  // Where the person is, for the country, city and campus leaderboards (see src/lib/places.ts).
  // countryCode is ISO 3166-1 alpha-2. city and campus hold tidied free text; the *Key columns
  // hold the comparable form ("São Paulo" -> "sao-paulo"), and are what the boards group by.
  countryCode          String?
  city                 String?
  cityKey              String?
  campus               String?
  campusKey            String?
  // Privacy. Opting out of leaderboards removes the person from every board and from every rank
  // others can see; hiding activity keeps the contribution heatmap to themselves.
  hideFromLeaderboards Boolean           @default(false)
  showActivity         Boolean           @default(true)
  // The rest of the privacy settings (GET/PATCH /api/users/me/privacy, src/lib/privacy/settings.ts).
  // Who sees each passport field: { field: PUBLIC | CONNECTIONS | PRIVATE }. A field not named is PUBLIC.
  fieldVisibility      Json              @default("{}")
  // Kept out of any recruiter surface (none exists yet; src/lib/age-policy.ts recruiterVisible is the one place it is read).
  hideFromRecruiters   Boolean           @default(false)
  // Not shown as active: no "last active", left out of discovery and search lists, presence not published.
  invisibleMode        Boolean           @default(false)
  whoCanMessage        MessagePermission @default(EVERYONE)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([countryCode])
  @@index([countryCode, cityKey])
  @@index([campusKey])
}

model Skill {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  category    String
  subcategory String?
  description String?  @db.Text
  icon        String?
  color       String?
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userSkills     UserSkill[]
  skillEvidences SkillEvidence[]
}

model UserSkill {
  id              String   @id @default(cuid())
  userId          String
  skillId         String
  level           Int      @default(1) // 1-5
  isVerified      Boolean  @default(false)
  yearsExperience Float?   @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  // Who has a skill: the matching pool ranks candidates by the skills a viewer is looking for.
  @@index([skillId])
}

model SkillEvidence {
  id              String    @id @default(cuid())
  userId          String
  skillId         String
  type            String // CHALLENGE, GITHUB_PROJECT, HACKATHON_PROJECT, CONTRIBUTION, PEER_ENDORSEMENT, PORTFOLIO, CERTIFICATION, CONNECTED_PROFILE
  title           String
  description     String?   @db.Text
  url             String?
  metadata        Json?
  verifiedAt      DateTime?
  // For a PEER_ENDORSEMENT row: how much it counts, 1 unless the nightly collusion job found it inside a dense reciprocal cluster (src/lib/integrity).
  // Lowered, never deleted; restored when an admin dismisses the signal.
  integrityWeight Float     @default(1)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)
}

model Project {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String?       @db.Text
  shortDesc   String?
  status      ProjectStatus @default(IDEA)
  ownerId     String
  hackathonId String?
  githubUrl   String?
  demoUrl     String?
  websiteUrl  String?
  thumbnail   String?
  isPublic    Boolean       @default(true)
  teamSize    Int           @default(1)
  maxTeamSize Int           @default(5)
  lookingFor  String[]      @default([])
  techStack   String[]      @default([])
  startedAt   DateTime?
  shippedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  owner        User            @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members      ProjectMember[]
  hackathon    Hackathon?      @relation(fields: [hackathonId], references: [id], onDelete: SetNull)
  team         Team?
  updates      ProjectUpdate[]
  milestones   Milestone[]
  chat         Chat?
  conversation Conversation?
  activities   Activity[]
  posts        ShipPost[]
  watchers     Watch[]
}

model ProjectMember {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  role      String   @default("MEMBER")
  joinedAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([projectId])
}

model ProjectUpdate {
  id        String   @id @default(cuid())
  projectId String
  authorId  String
  title     String
  content   String   @db.Text
  type      String   @default("UPDATE") // UPDATE, MILESTONE, SHIPPED, ANNOUNCEMENT
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model Milestone {
  id          String    @id @default(cuid())
  projectId   String
  title       String
  description String?   @db.Text
  dueDate     DateTime?
  completedAt DateTime?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Team {
  id             String    @id @default(cuid())
  name           String
  slug           String    @unique
  description    String?   @db.Text
  projectId      String?   @unique
  hackathonId    String?
  ownerId        String
  maxSize        Int       @default(5)
  isRecruiting   Boolean   @default(true)
  // DERIVED from the open slots (src/lib/squads/roles.ts derivedLookingFor), rewritten with every slot change, so clients and code that read it keep
  // working. A write to it from an old client is turned into OTHER slots.
  lookingFor     String[]  @default([])
  // The hackathon tracks (by name) this squad goes for; the squad builder's role template follows them.
  targetTracks   String[]  @default([])
  // "Keep building": when this hackathon team became a permanent crew. It keeps its members and roles, and no longer locks with the hackathon.
  keptBuildingAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  owner             User                @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members           TeamMember[]
  slots             TeamSlot[]
  applications      TeamApplication[]
  project           Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  hackathon         Hackathon?          @relation(fields: [hackathonId], references: [id], onDelete: SetNull)
  hackathonTeams    HackathonTeam[]
  chat              Chat?
  conversation      Conversation?
  SquadProposal     SquadProposal[]
  LfgPost           LfgPost[]
  TeamChecklistItem TeamChecklistItem[]
  TeamIdea          TeamIdea[]
}

model TeamMember {
  id        String     @id @default(cuid())
  userId    String
  teamId    String
  // Permissions on the team (owner, admin, member). What the person DOES on the squad is squadRole.
  role      TeamRole   @default(MEMBER)
  squadRole SquadRole?
  // Only for squadRole OTHER.
  roleLabel String?
  joinedAt  DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([teamId])
}

model TeamApplication {
  id          String                @id @default(cuid())
  userId      String
  teamId      String
  message     String?               @db.Text
  status      TeamApplicationStatus @default(PENDING)
  // Null (the default) means this is a self-initiated application, reviewed
  // by the team owner/admin as before. Set means the OWNER invited this
  // user directly - the accept/decline authorization flips to the invitee
  // (userId), not the team, since they're the one being asked. Everything
  // else about the row (the unique[userId,teamId] constraint, the accept
  // transaction, the maxSize guard) is shared and unchanged either way.
  invitedById String?
  // The open slot this application or invitation is for; accepting fills it.
  slotId      String?
  // Invitations expire (48h); applications do not (null).
  expiresAt   DateTime?
  // The squad proposal (the squad builder's) this invitation was sent for.
  proposalId  String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitedBy User?          @relation("TeamInvitationsSent", fields: [invitedById], references: [id], onDelete: SetNull)
  slot      TeamSlot?      @relation(fields: [slotId], references: [id], onDelete: SetNull)
  proposal  SquadProposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)

  @@unique([userId, teamId])
  @@index([teamId])
  // The expiry sweep.
  @@index([status, expiresAt])
}

// One open (or filled) position on a team: a role from the catalogue and the skills it needs. Accepting an application or invitation for it fills
// it; the member leaving reopens it.
model TeamSlot {
  id             String     @id @default(cuid())
  teamId         String
  role           SquadRole
  // Only for OTHER: what the role is called.
  customLabel    String?
  // Skill names, as Team.lookingFor always held them.
  requiredSkills String[]   @default([])
  status         SlotStatus @default(OPEN)
  filledById     String?
  filledAt       DateTime?
  // Display order on the team.
  position       Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  team         Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  filledBy     User?             @relation("TeamSlotsFilled", fields: [filledById], references: [id], onDelete: SetNull)
  applications TeamApplication[]

  @@index([teamId, status])
  @@index([filledById])
}

model Hackathon {
  id                   String             @id @default(cuid())
  name                 String
  slug                 String             @unique
  description          String             @db.Text
  shortDesc            String?
  startDate            DateTime
  endDate              DateTime
  registrationDeadline DateTime?
  // When member changes stop (the team locks). Null: the end date.
  submissionDeadline   DateTime?
  status               HackathonStatus    @default(UPCOMING)
  organizer            String?
  websiteUrl           String?
  prizePool            String?
  rules                String?            @db.Text
  technologies         String[]           @default([])
  maxTeamSize          Int                @default(5)
  minTeamSize          Int                @default(1)
  location             String? // ONLINE, HYBRID, or physical location
  // [{ name, description }]: what squads can go for (src/lib/squads/tracks.ts). At most 20.
  tracks               Json               @default("[]")
  source               HackathonSource    @default(NATIVE)
  // EXTERNAL: the page it lives on, normalised (src/lib/squads/external.ts), which is what duplicates are found by.
  externalUrl          String?            @unique
  platform             HackathonPlatform?
  mode                 HackathonMode?
  city                 String?
  country              String?
  // When results were first recorded: the peer-review window opens then (or at the end date, whichever is first).
  resultsAt            DateTime?
  // EXTERNAL: who submitted it, and when an admin verified it. Until then it is usable for squads but flagged UNVERIFIED, and pays no XP.
  submittedById        String?
  verifiedAt           DateTime?
  isPublic             Boolean            @default(true)
  // Set when a moderator hid or removed an external hackathon (with isPublic false).
  moderatedAt          DateTime?
  thumbnail            String?
  banner               String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  submittedBy      User?                  @relation("HackathonsSubmitted", fields: [submittedById], references: [id], onDelete: SetNull)
  participants     HackathonParticipant[]
  hackathonTeams   HackathonTeam[]
  projects         Project[]
  teams            Team[]
  squadProposals   SquadProposal[]
  formationRuns    SquadFormationRun[]
  lfgPosts         LfgPost[]
  currentBuilds    CurrentBuild[]
  chat             Chat?
  conversation     Conversation?
  CommitmentPledge CommitmentPledge[]
  PeerReview       PeerReview[]
}

model HackathonParticipant {
  id             String                     @id @default(cuid())
  userId         String
  hackathonId    String
  status         HackathonParticipantStatus @default(REGISTERED)
  teamId         String?
  registeredAt   DateTime                   @default(now())
  // When they joined the squad they are in for this hackathon (time-to-team, the admin metric).
  teamJoinedAt   DateTime?
  skills         String[]                   @default([])
  lookingFor     String[]                   @default([])
  // The solo pool (docs/SQUADS.md): looking for a team (the squad builder and the LFG board draw from these), the roles they would like to play,
  // and whether the auto-formation may put them in a squad.
  lookingForTeam Boolean                    @default(false)
  preferredRoles SquadRole[]                @default([])
  openToAutoTeam Boolean                    @default(false)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  hackathon Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)

  @@unique([userId, hackathonId])
  @@index([hackathonId, teamId])
  // The pool: teamless people of a hackathon who are looking.
  @@index([hackathonId, lookingForTeam, teamId])
}

model HackathonTeam {
  id          String   @id @default(cuid())
  hackathonId String
  teamId      String   @unique
  name        String
  projectId   String?
  rank        Int?
  score       Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hackathon Hackathon             @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  team      Team                  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  members   HackathonTeamMember[]
}

model HackathonTeamMember {
  id              String   @id @default(cuid())
  hackathonTeamId String
  userId          String
  role            String   @default("MEMBER")
  joinedAt        DateTime @default(now())

  hackathonTeam HackathonTeam @relation(fields: [hackathonTeamId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([hackathonTeamId, userId])
  // A person's squads across hackathons: teammates for peer reviews, pair history, reunions.
  @@index([userId])
}

model Challenge {
  id          String              @id @default(cuid())
  title       String
  slug        String              @unique
  description String              @db.Text
  category    ChallengeCategory
  difficulty  ChallengeDifficulty
  xpReward    Int                 @default(100)
  repoUrl     String?
  starterCode String?             @db.Text
  tests       Json?
  tags        String[]            @default([])
  isActive    Boolean             @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  attempts ChallengeAttempt[]
}

model ChallengeAttempt {
  id          String    @id @default(cuid())
  userId      String
  challengeId String
  code        String?   @db.Text
  language    String?
  status      String    @default("PENDING") // PENDING, PASSED, FAILED, RUNNING
  score       Int?
  output      String?   @db.Text
  passedTests Int       @default(0)
  totalTests  Int       @default(0)
  timeSpent   Int       @default(0) // seconds
  submittedAt DateTime  @default(now())
  completedAt DateTime?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
}

model Achievement {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  description     String    @db.Text
  icon            String?
  category        String
  xpReward        Int       @default(0)
  criteria        Json // { type, conditions }
  isSecret        Boolean   @default(false)
  order           Int       @default(0)
  // The share of users active in the last 30 days who have earned it, 0 to 1 (smaller is rarer).
  // Null until the nightly job (achievements/rarity) has run once.
  rarity          Float?
  rarityUpdatedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  earnedAt      DateTime @default(now())
  progress      Json? // { current, target } as it stood when it was earned

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

// How many times a user has done something that counts toward achievements and quests, one row per
// kind of thing (the metrics in src/lib/metrics.ts). It only ever goes up, and only through
// recordTick, which also writes the ProgressTick that makes each increment happen once.
model UserCounter {
  id        String   @id @default(cuid())
  userId    String
  key       String
  value     Int      @default(0)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

// One counted thing: "this user shipped this project". The unique key on (userId, metric, dedupeKey)
// is what makes a repeated event (un-endorsing and endorsing again, a retry) count once, and the
// timestamps answer the questions about a week ("three ships in one week").
model ProgressTick {
  id        String   @id @default(cuid())
  userId    String
  metric    String
  dedupeKey String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, metric, dedupeKey])
  @@index([userId, metric, createdAt])
}

enum CosmeticType {
  TITLE
  FRAME
  BANNER
  // Worn in the "badges" slot, up to three at a time.
  BADGE
  AVATAR_PART
}

enum CosmeticRarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
}

// Something a person shows on their profile: a title, a frame, a banner, a piece of avatar. They are only
// ever EARNED, by a rule in unlockRule (a tier, an achievement, a streak): nothing here has a price and no
// route grants one. The catalog is in src/lib/cosmetic-definitions.ts and rows are created from it on first
// use, like achievements. src/lib/cosmetics.ts is the only code that writes a UserCosmetic.
model Cosmetic {
  id          String         @id @default(cuid())
  slug        String         @unique
  type        CosmeticType
  name        String
  description String         @db.Text
  rarity      CosmeticRarity @default(COMMON)
  // What unlocks it, e.g. { "type": "TIER", "tier": "GOLD" } or { "type": "ACHIEVEMENT", "slug": "ship-100" }.
  unlockRule  Json
  order       Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  userCosmetics UserCosmetic[]

  @@index([type])
}

// A cosmetic a user has earned (their inventory). `source` says which rule unlocked it.
model UserCosmetic {
  id         String   @id @default(cuid())
  userId     String
  cosmeticId String
  source     String
  unlockedAt DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cosmetic Cosmetic @relation(fields: [cosmeticId], references: [id], onDelete: Cascade)

  @@unique([userId, cosmeticId])
  @@index([userId])
}

model XPEvent {
  id          String   @id @default(cuid())
  userId      String
  type        String // The reward action: one of the keys of REWARD_RULES in src/lib/rewards-config.ts
  amount      Int
  description String
  metadata    Json?
  // The season being played when it was earned (see Season). Null for XP from before seasons began.
  seasonId    String?
  // What earned it (PROJECT, HACKATHON, ACHIEVEMENT, ...) and which row.
  sourceType  String?
  sourceId    String?
  // Identifies "the same award" for this user and action, so a retry or a race
  // cannot pay twice. Null on rows from before the rewards engine, which the
  // unique index below treats as distinct.
  dedupeKey   String?
  createdAt   DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  season Season? @relation(fields: [seasonId], references: [id], onDelete: SetNull)

  @@unique([userId, type, dedupeKey])
  @@index([userId, createdAt])
  @@index([userId, type, createdAt])
  // Leaderboards and the nightly reconcile add XP up over a time range or a season.
  @@index([createdAt])
  @@index([seasonId, userId])
}

// A fixed stretch of time with its own leaderboard. At most one is active (the rollover job closes
// one and opens the next in the same transaction). Every XPEvent is stamped with the season it was
// earned in, so a season's standings are always a sum over the log.
model Season {
  id               String    @id @default(cuid())
  number           Int       @unique
  name             String
  startsAt         DateTime
  endsAt           DateTime
  active           Boolean   @default(false)
  // Set when the rollover job has closed the season and written its final standings.
  closedAt         DateTime?
  // Set when the season's cosmetic rewards (title, frames, participation badge) have been granted. Null until then;
  // the rollover job grants them for every closed season that is still null.
  rewardsGrantedAt DateTime?
  createdAt        DateTime  @default(now())

  xpEvents  XPEvent[]
  standings SeasonStanding[]

  @@index([active])
}

// A season's final standing for one person, written once when the season closes. The season's cosmetic
// rewards (see src/lib/seasons.ts) are granted from this record; no XP is paid for a placing.
model SeasonStanding {
  id        String   @id @default(cuid())
  seasonId  String
  userId    String
  rank      Int
  score     Int
  createdAt DateTime @default(now())

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([seasonId, userId])
  @@index([seasonId, rank])
  @@index([userId])
}

model ReputationEvent {
  id          String   @id @default(cuid())
  userId      String
  type        String // PROJECT_SHIPPED, HACKATHON_PLACEMENT, CHALLENGE_COMPLETE, OSS_CONTRIBUTION, TEAM_ENDORSEMENT, PEER_ENDORSEMENT, SKILL_VERIFIED
  amount      Int
  sourceId    String? // Reference to project, hackathon, challenge, etc.
  sourceType  String? // PROJECT, HACKATHON, CHALLENGE, USER
  description String
  metadata    Json?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Connection {
  id         String         @id @default(cuid())
  senderId   String
  receiverId String
  type       ConnectionType @default(NETWORK)
  status     String         @default("PENDING") // PENDING, ACCEPTED, DECLINED, BLOCKED
  message    String?        @db.Text
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  sender   User @relation("SentConnections", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedConnections", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([receiverId])
}

model Conversation {
  id           String    @id @default(cuid())
  type         String    @default("DIRECT") // DIRECT, GROUP, PROJECT, TEAM, HACKATHON
  name         String?
  projectId    String?   @unique
  teamId       String?   @unique
  hackathonId  String?   @unique
  // Set when the conversation was closed for good (a match was ended): nobody can post in it any more, and it stays readable.
  closedAt     DateTime?
  closedReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  members   ConversationMember[]
  messages  Message[]
  chats     Chat[]
  match     Match?
  project   Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  team      Team?                @relation(fields: [teamId], references: [id], onDelete: SetNull)
  hackathon Hackathon?           @relation(fields: [hackathonId], references: [id], onDelete: SetNull)
}

model ConversationMember {
  id             String    @id @default(cuid())
  userId         String
  conversationId String
  role           String    @default("MEMBER") // MEMBER, ADMIN, OWNER
  joinedAt       DateTime  @default(now())
  lastReadAt     DateTime?
  isMuted        Boolean   @default(false)
  isPinned       Boolean   @default(false)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([userId, conversationId])
  @@index([conversationId])
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  content        String    @db.Text
  type           String    @default("TEXT") // TEXT, IMAGE, FILE, SYSTEM, CODE, LINK_PREVIEW
  replyToId      String?
  editedAt       DateTime?
  // Set when a moderator hid or removed it (with deletedAt); a hide can be undone, a removal also blanks the text.
  moderatedAt    DateTime?
  deletedAt      DateTime?
  metadata       Json?
  createdAt      DateTime  @default(now())

  conversation Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User              @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo      Message?          @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]         @relation("MessageReplies")
  reactions    MessageReaction[]
  reads        MessageRead[]

  @@index([conversationId, createdAt])
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
}

model MessageRead {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  readAt    DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
}

model Chat {
  id             String   @id @default(cuid())
  type           String // PROJECT, TEAM, HACKATHON
  projectId      String?  @unique
  teamId         String?  @unique
  hackathonId    String?  @unique
  conversationId String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project      Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  team         Team?        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  hackathon    Hackathon?   @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model Notification {
  id          String           @id @default(cuid())
  userId      String
  type        NotificationType
  title       String
  message     String           @db.Text
  link        String?
  metadata    Json?
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())
  // Notifications that stand for several events ("12 people gave Props to X") share a key within a time window; the row is updated, not repeated (src/lib/notifications.ts).
  coalesceKey String?
  count       Int              @default(1)
  // When the delivery pipeline looked at it to decide what leaves the app (email, push: src/lib/notify). Null until then; every writer of a notification is covered
  // by the sweep that sets it, so none of them has to know about delivery. Notifications from before delivery existed were stamped when it was introduced.
  sweptAt     DateTime?

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@unique([userId, coalesceKey])
  @@index([userId, isRead])
  // The sweep: notifications not yet looked at, oldest first.
  @@index([sweptAt, createdAt])
}

// Which kinds of notification a person has switched off (src/lib/notifications.ts). No row means the kind is on; a row says what they chose.
model NotificationPreference {
  id        String   @id @default(cuid())
  userId    String
  kind      String
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
}

model Report {
  id           String       @id @default(cuid())
  // Null for a report the platform filed itself (source AUTOMATED).
  reporterId   String?
  // The person the report is about: the reported user, or whoever made the reported thing.
  reportedId   String
  reason       ReportReason
  description  String?      @db.Text
  status       ReportStatus @default(PENDING)
  metadata     Json?
  targetType   ReportTarget @default(USER)
  // The reported thing's id (null for USER, where it is reportedId).
  targetId     String?
  source       ReportSource @default(USER)
  // Higher first in the queue (src/lib/moderation/priority.ts): minor safety and the romance mode, then impersonation, then by reporter trust and volume.
  priority     Int          @default(0)
  // What the reported thing said when it was reported, so an edit or a delete does not erase the evidence. Kept as long as the report (2 years once resolved).
  snapshot     Json?
  resolvedAt   DateTime?
  resolvedById String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  reporter User? @relation("ReportsSubmitted", fields: [reporterId], references: [id], onDelete: Cascade)
  reported User  @relation("ReportsAgainst", fields: [reportedId], references: [id], onDelete: Cascade)

  @@index([status])
  // The queue: open reports, most urgent first.
  @@index([status, priority, createdAt])
  @@index([reportedId, createdAt])
  @@index([targetType, targetId])
  // Retention: resolved reports older than two years.
  @@index([resolvedAt])
}

// One decision by a moderator or an admin (src/lib/moderation/actions.ts). Never deleted; a reversal is recorded on it.
model ModerationAction {
  id              String    @id @default(cuid())
  moderatorId     String
  targetId        String
  // USER or a ReportTarget value.
  targetType      String
  // WARN, HIDE_CONTENT, REMOVE_CONTENT, RESTRICT_FEATURE, SUSPEND, BAN, APPROVE_MEDIA (src/lib/moderation/actions.ts MODERATION_ACTIONS).
  action          String
  reason          String    @db.Text
  duration        Int? // For temporary actions (in days)
  metadata        Json?
  // The person it is about (the user, or whoever made the content).
  subjectUserId   String?
  reportId        String?
  // What the person is told, besides the reason's category. Shown to them.
  noteToUser      String?   @db.Text
  // RESTRICT_FEATURE: romance, messaging or posting.
  feature         String?
  expiresAt       DateTime?
  // Until when the person may appeal (null: not appealable, e.g. a warning).
  appealableUntil DateTime?
  reversedAt      DateTime?
  reversedById    String?
  reverseReason   String?   @db.Text
  createdAt       DateTime  @default(now())

  moderator User    @relation(fields: [moderatorId], references: [id], onDelete: Cascade)
  appeal    Appeal?

  @@index([subjectUserId, createdAt])
  @@index([reportId])
}

// A person asking for a moderation action against them to be looked at again (POST /api/appeals). One per action. Reviewed in the queue.
model Appeal {
  id           String       @id @default(cuid())
  actionId     String       @unique
  userId       String
  body         String       @db.Text
  status       AppealStatus @default(PENDING)
  decidedById  String?
  decisionNote String?      @db.Text
  decidedAt    DateTime?
  createdAt    DateTime     @default(now())

  action ModerationAction @relation(fields: [actionId], references: [id], onDelete: Cascade)
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

// What a moderation action closed for a person, and until when (null: until lifted). Lifted, never deleted.
model UserRestriction {
  id        String          @id @default(cuid())
  userId    String
  kind      RestrictionKind
  actionId  String?
  endsAt    DateTime?
  liftedAt  DateTime?
  createdAt DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, liftedAt])
}

// One person hiding another without blocking them (POST /api/mutes): the muted person's posts, comments and listings no longer show to the muter.
// Nothing is said to the muted person, and they can still interact (unlike a block).
model Mute {
  id        String   @id @default(cuid())
  muterId   String
  mutedId   String
  createdAt DateTime @default(now())

  muter User @relation("MutesMade", fields: [muterId], references: [id], onDelete: Cascade)
  muted User @relation("MutesReceived", fields: [mutedId], references: [id], onDelete: Cascade)

  @@unique([muterId, mutedId])
  @@index([mutedId])
}

model AuditEvent {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  targetType String
  targetId   String?
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Verification {
  id         String    @id @default(cuid())
  userId     String
  type       String // EMAIL, PHONE, GITHUB, PORTFOLIO, ORGANIZATION, IDENTITY
  status     String    @default("PENDING") // PENDING, VERIFIED, REJECTED, EXPIRED
  provider   String?
  providerId String?
  metadata   Json?
  verifiedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CurrentBuild {
  id          String        @id @default(cuid())
  userId      String        @unique
  title       String
  description String?       @db.Text
  status      ProjectStatus @default(BUILDING)
  progress    Int           @default(0) // 0-100
  techStack   String[]      @default([])
  teamSize    Int           @default(1)
  maxTeamSize Int           @default(5)
  rolesNeeded String[]      @default([])
  hackathonId String?
  githubUrl   String?
  demoUrl     String?
  isPublic    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  hackathon Hackathon? @relation(fields: [hackathonId], references: [id])

  @@index([hackathonId])
}

// A quest a user can be given: a small, useful thing to do inside a day or a week. The catalog is in
// src/lib/quest-definitions.ts and rows are created from it on first use (like achievements); which
// three daily and three weekly quests a person sees is decided by a hash of (user, period), not stored
// here. startsAt and endsAt are only for hand-made quests with a fixed window; a rotating quest has none.
model Quest {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  description   String    @db.Text
  type          String // DAILY, WEEKLY, SPECIAL
  criteria      Json // { metric, target } for the rotating quests
  xpReward      Int       @default(0)
  achievementId String?
  startsAt      DateTime?
  endsAt        DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  userQuests UserQuest[]
}

// One user's go at one quest in one period (a local day or week). Created when the first thing that
// counts toward it happens, so a row exists only for quests the user has started.
model UserQuest {
  id          String    @id @default(cuid())
  userId      String
  questId     String
  // The period it belongs to: the local date ("2026-10-16") for a daily quest, the ISO week ("2026-W42")
  // for a weekly one, in the user's time zone then.
  periodKey   String
  periodStart DateTime
  periodEnd   DateTime
  progress    Json // { current, target, completed }
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest Quest @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@unique([userId, questId, periodKey])
  @@index([userId, periodEnd])
}

model Activity {
  id          String   @id @default(cuid())
  userId      String
  type        String // PROJECT_SHIPPED, HACKATHON_JOINED, HACKATHON_WON, CHALLENGE_COMPLETED, TEAM_JOINED, ACHIEVEMENT_EARNED, OSS_RELEASED, MILESTONE_REACHED
  title       String
  description String?  @db.Text
  link        String?
  metadata    Json?
  createdAt   DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId String?

  @@index([userId, createdAt])
}

// One user blocking another. Directional (A blocks B is not B blocks A), but
// enforcement is symmetric: neither side can message, connect, invite or
// apply to the other while either direction exists.
model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  reason    String?
  createdAt DateTime @default(now())

  blocker User @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model Leaderboard {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  type        String // GLOBAL, HACKATHON, TECHNICAL, SHIPPING, RISING, CHALLENGE
  period      String // ALL_TIME, MONTHLY, WEEKLY, DAILY
  hackathonId String?
  criteria    Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entries LeaderboardEntry[]
}

model LeaderboardEntry {
  id            String   @id @default(cuid())
  leaderboardId String
  userId        String
  rank          Int
  score         Int
  metadata      Json?
  calculatedAt  DateTime @default(now())

  leaderboard Leaderboard @relation(fields: [leaderboardId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([leaderboardId, userId])
}

enum SubscriptionPlan {
  FREE
  PRO
  CREW_PRO
  ORG
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  EXPIRED
}

// What a user is entitled to (see src/lib/entitlements.ts). A user without a row
// is on FREE. provider and providerRef are reserved for the billing integration
// and are not written by anything yet.
model Subscription {
  id               String             @id @default(cuid())
  userId           String             @unique
  plan             SubscriptionPlan   @default(FREE)
  status           SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd DateTime?
  provider         String?
  providerRef      String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([provider, providerRef])
}

// Runtime switches (see src/lib/flags.ts). A user is in when they are on the
// allowlist, or the flag is enabled and their stable hash falls under rolloutPercent.
model FeatureFlag {
  id             String   @id @default(cuid())
  key            String   @unique
  description    String?
  enabled        Boolean  @default(false)
  rolloutPercent Int      @default(100)
  allowUserIds   String[] @default([])
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Product analytics (see src/lib/infra/analytics.ts). props never holds personal data.
// userId is set to null when the user is deleted, so the counts survive but the link does not.
model ProductEvent {
  id        String   @id @default(cuid())
  name      String
  userId    String?
  props     Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([name, createdAt])
  @@index([userId, name])
}

// How a person wants to be matched (src/lib/matching). One row per user, created by the first PUT /api/matching/profile.
model MatchingProfile {
  id               String      @id @default(cuid())
  userId           String      @unique
  // Never empty once saved. DATING is only ever present for someone who passed the dating gate (src/lib/matching/dating.ts).
  connectionTypes  MatchType[]
  // [{ tag, hackathonId?, expiresAt? }], at most 10.
  intentTags       Json        @default("[]")
  hoursPerWeek     Int?
  availableFrom    DateTime?   @db.Date
  remoteOk         Boolean     @default(true)
  // Only match with people in the same city (Profile.cityKey).
  cityOnly         Boolean     @default(false)
  // Skill slugs.
  lookingForSkills String[]    @default([])
  // Answers to the fixed working-style quiz: { questionId: optionId }.
  workingStyle     Json        @default("{}")
  // "HH:MM" in the person's own time zone: when their daily drops arrive.
  dropTimeLocal    String      @default("09:00")
  paused           Boolean     @default(false)
  // The local date ("YYYY-MM-DD", in their zone then) that drops were last generated for, so a day is generated once.
  lastDropDate     String?
  // When the daily "N people sparked you" notification was last sent, so it is sent once a local day and counts only the sparks since.
  sparkDigestAt    DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([paused, dropTimeLocal])
  @@index([connectionTypes], type: Gin)
}

enum DropStatus {
  NEW
  SPARKED
  PASSED
  EXPIRED
}

// One person shown to another for one local day (src/lib/matching/drops.ts). `userId` is who it is for, `candidateId` who they are shown.
// A person is shown to someone at most once a day (the unique key), and `connectionType` is the relationship from the VIEWER's side.
model Drop {
  id             String     @id @default(cuid())
  userId         String
  candidateId    String
  connectionType MatchType
  // 0 to 100, from src/lib/matching/score.ts, and the (at most three) lines that explain it.
  score          Int
  reasons        Json       @default("[]")
  // The viewer's own calendar day the drop belongs to, "YYYY-MM-DD" in their time zone then.
  localDate      String
  status         DropStatus @default(NEW)
  // Resurfaced from a pass because the person has grown since (src/lib/matching/second-look.ts).
  secondLook     Boolean    @default(false)
  // What the candidate looked like when the viewer passed: { tier, verifiedEvidence }. The second look compares against it.
  passSnapshot   Json?
  // The end of the viewer's local day.
  expiresAt      DateTime
  viewedAt       DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  user      User    @relation("DropsReceived", fields: [userId], references: [id], onDelete: Cascade)
  candidate User    @relation("DropsShown", fields: [candidateId], references: [id], onDelete: Cascade)
  sparks    Spark[]

  @@unique([userId, candidateId, localDate])
  // Today's drops, and "was this person shown or passed lately" for one viewer.
  @@index([userId, localDate])
  @@index([userId, candidateId, createdAt])
  // How often a candidate has been shown today (the fairness cap).
  @@index([candidateId, createdAt])
  // The expiry job.
  @@index([status, expiresAt])
  // The weekly second look: passes of a certain age.
  @@index([status, updatedAt])
}

enum SparkStatus {
  PENDING
  MATCHED
}

// "I'd like to work with you", with a reason. Two sparks that answer each other (the second one's type is the counterpart of the first's) make a
// Match. `connectionType` is the SENDER's side of the relationship. Sparks pay no XP.
model Spark {
  id             String      @id @default(cuid())
  fromId         String
  toId           String
  dropId         String?
  connectionType MatchType
  // 20 to 280 characters the sender wrote; what the receiver sees (if their plan shows it).
  opener         String
  // A fingerprint of the opener's words, to notice the same message going to many people.
  openerHash     String
  status         SparkStatus @default(PENDING)
  // Set when a moderator hid it: the receiver no longer sees it.
  moderatedAt    DateTime?
  createdAt      DateTime    @default(now())

  from User  @relation("SparksSent", fields: [fromId], references: [id], onDelete: Cascade)
  to   User  @relation("SparksReceived", fields: [toId], references: [id], onDelete: Cascade)
  drop Drop? @relation(fields: [dropId], references: [id], onDelete: SetNull)

  // One spark from a person to another per type of relationship.
  @@unique([fromId, toId, connectionType])
  // The received list, newest first.
  @@index([toId, status, createdAt])
  // The daily digest: who was sparked lately and is still waiting.
  @@index([status, createdAt])
  // How many a person sent today, and their recent openers.
  @@index([fromId, createdAt])
  // The same opener sent again.
  @@index([openerHash, createdAt])
}

enum MatchEndReason {
  UNMATCHED
  REPORTED
  BLOCKED
}

// Two people who sparked each other. userAId is always the smaller id, so a pair is one row whichever of them sparked first (the check constraint
// in the migration keeps it so); connectionType names the relationship the same from both sides (a mentor and a mentee are a MENTOR match).
model Match {
  id             String          @id @default(cuid())
  userAId        String
  userBId        String
  userARole      MatchType
  userBRole      MatchType
  connectionType MatchType
  conversationId String?         @unique
  createdAt      DateTime        @default(now())
  // Unmatching is final: once set, the pair is never matched, dropped to each other or sparked again.
  endedAt        DateTime?
  endedById      String?
  endReason      MatchEndReason?

  userA         User           @relation("MatchesAsA", fields: [userAId], references: [id], onDelete: Cascade)
  userB         User           @relation("MatchesAsB", fields: [userBId], references: [id], onDelete: Cascade)
  conversation  Conversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  // Romance matches only (connectionType DATING): the photo reveal and the Phase 2 Build Dates.
  revealRequest RevealRequest?
  buildDates    BuildDate[]

  @@unique([userAId, userBId, connectionType])
  @@index([userBId, endedAt])
  @@index([userAId, endedAt])
}

enum MediaPurpose {
  POST_MEDIA
  ROMANCE_PHOTO
  // A profile picture (PUT /api/users/me/avatar). Scanned before it is shown, like a romance photo.
  AVATAR
}

enum MediaKind {
  IMAGE
  GIF
  VIDEO
}

enum MediaStatus {
  // Declared and a presigned upload issued; the object has not been checked yet.
  PENDING
  // Uploaded, and its real size and type matched the declaration.
  READY
  // Uploaded but not what was declared; the object is deleted.
  REJECTED
  // Uploaded and checked, waiting for the media scanner (src/lib/infra/media-moderation.ts). Never served.
  SCANNING
  // The scanner was unsure: waiting for a moderator in the queue. Never served.
  IN_REVIEW
  // The scanner or a moderator refused it. The object is deleted; only the hash, the verdict and the labels are kept (docs/SAFETY.md).
  BLOCKED
}

// A file a person uploaded or is about to (src/lib/media-assets.ts). The server never receives the bytes: it checks a declaration (type, size, dimensions, hash),
// signs an upload straight to the bucket, and then looks at the real object. `key` is where it lives in the bucket; (ownerId, purpose, sha256) is unique, which
// is the content-hash dedupe: uploading the same file twice is one object.
model MediaAsset {
  id          String       @id @default(cuid())
  ownerId     String
  purpose     MediaPurpose
  kind        MediaKind
  key         String       @unique
  contentType String
  bytes       Int
  width       Int
  height      Int
  durationMs  Int?
  sha256      String
  status      MediaStatus  @default(PENDING)
  // The media scanner's answer (SAFE, NEEDS_REVIEW, BLOCKED) and its labels, for purposes that are scanned.
  scanVerdict String?
  scanLabels  String[]     @default([])
  scannedAt   DateTime?
  createdAt   DateTime     @default(now())
  confirmedAt DateTime?

  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  romancePhoto RomancePhoto?

  @@unique([ownerId, purpose, sha256])
  // A person's unfinished uploads, and the cleanup of abandoned ones.
  @@index([ownerId, status])
  @@index([status, createdAt])
}

// --- The romance mode (src/lib/romance, docs/ROMANCE.md) ----------------------------------------------------------
// Its tables are its own: nothing in the professional model (MatchingProfile, Drop) holds a romance fact. The storage key of the old model stays `DATING`
// (the MatchType and ConnectionType value, and the Match rows made with it); the mode's name is not final and is never stored.

enum RomanceGender {
  WOMAN
  MAN
  NON_BINARY
  // Described in the person's own words (RomanceProfile.genderSelfDescribe). Also what "interested in" says for people who describe themselves another way.
  SELF_DESCRIBED
}

enum RomanceScope {
  CITY
  COUNTRY
  ANYWHERE
}

// A person's romance profile. 1:1 with User, created by opting in (PUT /api/romance/profile, behind the 18+ gate). The first half is what a match sees; the
// PRIVATE FILTERS below it are returned to the owner and to nobody else, and only ever decide who is shown to whom.
model RomanceProfile {
  id                 String          @id @default(cuid())
  userId             String          @unique
  promptObsessed     String          @db.Text
  promptBuild        String          @db.Text
  promptWeekend      String          @db.Text
  // 1 to 4 (src/lib/romance/config.ts AMBITION_LEVELS).
  ambition           Int
  direction          String
  rhythm             String
  obsessions         String[]        @default([])
  // --- private filters ---
  gender             RomanceGender
  genderSelfDescribe String?
  interestedIn       RomanceGender[]
  ageMin             Int
  ageMax             Int
  scope              RomanceScope    @default(COUNTRY)
  // "Only people endorsed by at least this many builders can spark me": 0 to 5.
  minEndorsements    Int             @default(0)
  paused             Boolean         @default(false)
  // Set when a moderator hid the profile: it stays paused, and its owner cannot unpause it until a moderator undoes the hide.
  moderatedAt        DateTime?
  // The ISO week ("2026-W43", in their zone then) the weekly drop was last made for, so a week is made once.
  lastDropWeek       String?
  // The local date ("YYYY-MM-DD") of the last time a drop was looked for and none was found, so an empty week is looked at once a day and not every hour.
  lastDropTryDate    String?
  // When the daily "N people sparked you in <the mode>" notification was last sent (the romance counterpart of MatchingProfile.sparkDigestAt).
  sparkDigestAt      DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos RomancePhoto[]

  @@index([paused, gender])
  @@index([interestedIn], type: Gin)
}

// A photo is stored, and returned to its owner; anyone else gets a blurred placeholder until the two have revealed to each other (src/lib/romance/reveal.ts).
model RomancePhoto {
  id        String   @id @default(cuid())
  profileId String
  assetId   String   @unique
  // Where it is in the owner's order, from 0.
  position  Int
  // A BlurHash the client computed, shown in place of the photo to anybody who may not see it yet.
  blurHash  String?
  createdAt DateTime @default(now())

  profile RomanceProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  asset   MediaAsset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([profileId, position])
}

// The ONE person a person is shown each week (src/lib/romance/drops.ts). `weekKey` is the ISO week in the viewer's zone, so (userId, weekKey) unique is "one a week".
model RomanceDrop {
  id          String     @id @default(cuid())
  userId      String
  candidateId String
  // 0 to 100, from scoreRomance(), and the (at most three) lines that explain it.
  score       Int
  reasons     Json       @default("[]")
  weekKey     String
  status      DropStatus @default(NEW)
  // The end of the viewer's local week.
  expiresAt   DateTime
  viewedAt    DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user      User @relation("RomanceDropsReceived", fields: [userId], references: [id], onDelete: Cascade)
  candidate User @relation("RomanceDropsShown", fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([userId, weekKey])
  // "Was this person shown to this viewer lately".
  @@index([userId, candidateId, createdAt])
  // How often a candidate has been shown this week (the exposure cap).
  @@index([candidateId, createdAt])
  @@index([status, expiresAt])
}

enum RevealStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
}

// Photos are shown to the other person of a romance match only when BOTH have agreed (src/lib/romance/reveal.ts). One row per match: the request, who made it, and where it
// stands. Either person can revoke an accepted reveal at any time, and ending the match revokes it. `buildDateId` is for Phase 2: a Build Date (the first date as a
// micro-collab) that unlocks the reveal; nothing writes it yet.
model RevealRequest {
  id          String       @id @default(cuid())
  matchId     String       @unique
  requesterId String
  status      RevealStatus @default(PENDING)
  buildDateId String?      @unique
  respondedAt DateTime?
  revokedAt   DateTime?
  revokedById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  match     Match      @relation(fields: [matchId], references: [id], onDelete: Cascade)
  buildDate BuildDate? @relation(fields: [buildDateId], references: [id], onDelete: SetNull)
}

enum BuildDateStatus {
  PROPOSED
  ACCEPTED
  COMPLETED
  CANCELLED
}

// PHASE 2 STUB. A Build Date is the first date as a small collaboration. Only the model and its statuses exist, so that the reveal flow can key off a completed one later;
// no route reads or writes it yet.
model BuildDate {
  id           String          @id @default(cuid())
  matchId      String
  proposedById String
  status       BuildDateStatus @default(PROPOSED)
  scheduledFor DateTime?
  completedAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  match  Match          @relation(fields: [matchId], references: [id], onDelete: Cascade)
  reveal RevealRequest?

  @@index([matchId])
}

enum DuoStatus {
  PENDING
  ACTIVE
  DISSOLVED
}

// Two people who agreed to share a page (src/lib/romance/duo.ts): their joint projects and a combined heatmap. Both must consent (one asks, the other accepts) and either can
// dissolve it. userAId is always the smaller id, so a pair is one row (a check constraint in the migration keeps it so).
model Duo {
  id            String    @id @default(cuid())
  userAId       String
  userBId       String
  requestedById String
  status        DuoStatus @default(PENDING)
  acceptedAt    DateTime?
  dissolvedAt   DateTime?
  dissolvedById String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  userA User @relation("DuoAsA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("DuoAsB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userBId, status])
  @@index([userAId, status])
}

// --- Ship posts and the feed (src/lib/posts, src/lib/feed, docs/FEED.md) --------------------------------------------------

enum PostKind {
  SHIP
  UPDATE
  DEVLOG
  DEMO
}

enum PostVisibility {
  PUBLIC
  FOLLOWERS
  CREW
}

// Something a builder shows: a ship, an update, a devlog or a demo. Body is Markdown, sanitised on the way in. `media` is [{ assetId, key, type, width, height, durationMs }] from the
// author's own confirmed uploads. Deleting is soft. `propsScore` is the sum of the weights of its Props (denormalised, updated in the same transaction as the Prop).
model ShipPost {
  id              String         @id @default(cuid())
  authorId        String
  projectId       String?
  teamId          String?
  kind            PostKind
  title           String
  body            String         @db.Text
  links           String[]       @default([])
  media           Json           @default("[]")
  stackTags       String[]       @default([])
  // Other members of the project or crew who share the credit.
  coAuthorIds     String[]       @default([])
  visibility      PostVisibility @default(PUBLIC)
  // The author's local Friday ("YYYY-MM-DD") when the post was made on Ship Day, else null.
  shipDayKey      String?
  propsScore      Float          @default(0)
  propsCount      Int            @default(0)
  commentCount    Int            @default(0)
  // How many times it was edited (a lightweight revision count).
  revision        Int            @default(0)
  // The ProjectUpdate an UPDATE or DEVLOG post counted as, which carries the existing XP and caps.
  projectUpdateId String?
  createdAt       DateTime       @default(now())
  editedAt        DateTime?
  // Set when a moderator hid or removed it (with deletedAt); a hide can be undone, a removal also blanks the text.
  moderatedAt     DateTime?
  deletedAt       DateTime?

  author   User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  project  Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  props    Prop[]
  comments Comment[]

  @@index([authorId, createdAt])
  @@index([projectId, createdAt])
  @@index([teamId, createdAt])
  @@index([createdAt])
  @@index([shipDayKey])
  @@index([coAuthorIds], type: Gin)
}

// One builder's respect for one post. Unique per pair. `weight` is fixed when it is given (src/lib/posts/props-weight.ts); 0 for a giver the trust gate does not trust.
model Prop {
  id              String   @id @default(cuid())
  userId          String
  postId          String
  weight          Float
  // Multiplies `weight` in the post's propsScore: 1 unless the collusion job lowered it (src/lib/integrity). Restored when the signal is dismissed.
  integrityWeight Float    @default(1)
  createdAt       DateTime @default(now())

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post ShipPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId, createdAt])
  @@index([userId, createdAt])
}

// One level of threading: a reply's parent is always a top-level comment. Deleting is soft (the thread keeps its shape). Editable for a short window.
model Comment {
  id          String    @id @default(cuid())
  postId      String
  authorId    String
  parentId    String?
  body        String    @db.Text
  editedAt    DateTime?
  // Set when a moderator hid or removed it (with deletedAt); a hide can be undone, a removal also blanks the text.
  moderatedAt DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())

  post    ShipPost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("Replies")

  @@index([postId, createdAt])
  @@index([parentId, createdAt])
}

model Follow {
  id         String   @id @default(cuid())
  followerId String
  followeeId String
  createdAt  DateTime @default(now())

  follower User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  followee User @relation("Followers", fields: [followeeId], references: [id], onDelete: Cascade)

  @@unique([followerId, followeeId])
  @@index([followeeId, createdAt])
}

// A user watching a project: posts on it reach them (src/lib/posts/watch.ts).
model Watch {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([projectId])
}

// Something that looks off and is worth a person's eye later, recorded and never acted on by itself (for example a burst of Props from new accounts).
model IntegritySignal {
  id          String   @id @default(cuid())
  kind        String
  userId      String?
  subjectType String
  subjectId   String
  data        Json     @default("{}")
  createdAt   DateTime @default(now())

  @@index([kind, createdAt])
  @@index([subjectType, subjectId])
}

// The Saturday recap of a Ship Day (src/lib/posts/ship-day-recap.ts): one row per ISO week.
model ShipDayRecap {
  id         String   @id @default(cuid())
  weekKey    String   @unique
  dateKey    String
  totalPosts Int
  // [{ postId, authorId, propsScore, title }] best first.
  topPosts   Json     @default("[]")
  // { countries: [{ code, count }], cities: [{ key, count }], campuses: [{ key, count }] }
  places     Json     @default("{}")
  createdAt  DateTime @default(now())
}

// A complete squad the optimiser proposed (src/lib/squads/builder.ts, src/lib/squads/pool.ts): its members with the role each would play and why,
// the squad strength it was proposed at, and the seed that makes it reproducible. A BUILDER proposal expires after 24 hours; an AUTO one is answered
// by its members within 24 hours.
model SquadProposal {
  id          String              @id @default(cuid())
  hackathonId String
  kind        SquadProposalKind
  status      SquadProposalStatus
  // BUILDER: who asked. AUTO: null.
  requesterId String?
  // The team it became (or, for a requester who already had one, the team it completes).
  teamId      String?
  // AUTO: the formation round it belongs to.
  runId       String?
  seed        Int
  size        Int
  // Squad strength (0 to 100) when proposed, and its components and gaps.
  strength    Int
  detail      Json                @default("{}")
  expiresAt   DateTime
  decidedAt   DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  hackathon   Hackathon             @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  requester   User?                 @relation("SquadProposalsRequested", fields: [requesterId], references: [id], onDelete: SetNull)
  team        Team?                 @relation(fields: [teamId], references: [id], onDelete: SetNull)
  run         SquadFormationRun?    @relation(fields: [runId], references: [id], onDelete: Cascade)
  members     SquadProposalMember[]
  invitations TeamApplication[]

  // The settle sweep: AUTO proposals still PROPOSED past their time.
  @@index([status, expiresAt])
  @@index([hackathonId, kind, status])
  // Rate limit and listing of a requester's proposals.
  @@index([requesterId, createdAt])
  @@index([runId])
}

model SquadProposalMember {
  id          String           @id @default(cuid())
  proposalId  String
  userId      String
  role        SquadRole
  roleLabel   String?
  // Why this person (from the pairwise score), at most three lines.
  reasons     String[]         @default([])
  position    Int              @default(0)
  response    ProposalResponse @default(PENDING)
  respondedAt DateTime?

  proposal SquadProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([proposalId, userId])
  // "My proposals".
  @@index([userId, response])
}

// One round of the solo-pool auto-formation for a hackathon (round 1 at registrationDeadline - 48h, round 2 for the people re-pooled once). The
// unique (hackathonId, round) is what makes a run happen once however many times the job fires; its proposals are written in the same transaction.
model SquadFormationRun {
  id          String    @id @default(cuid())
  hackathonId String
  round       Int
  poolSize    Int
  squads      Int
  leftovers   Int
  createdAt   DateTime  @default(now())
  // Set when every proposal of the round has been decided.
  settledAt   DateTime?

  hackathon Hackathon       @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  proposals SquadProposal[]

  @@unique([hackathonId, round])
}

// The looking-for-group board of a hackathon (GET /api/hackathons/{id}/lfg). One ACTIVE post per person per hackathon, kept by the create route
// under an advisory lock (src/lib/squads/lfg.ts). A post is active until it is closed (deleted by its author, or replaced) or its expiresAt passes.
model LfgPost {
  id          String      @id @default(cuid())
  hackathonId String
  authorId    String
  kind        LfgKind
  // TEAM posts: the team, which the author manages.
  teamId      String?
  roles       SquadRole[] @default([])
  // Technologies, as written (compared without case).
  stack       String[]    @default([])
  // An IANA time zone.
  timezone    String?
  note        String
  expiresAt   DateTime
  closedAt    DateTime?
  // Set when a moderator hid or removed it (with closedAt).
  moderatedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  hackathon Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  team      Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)

  // The board: a hackathon's open posts, newest first (the fit ranking is worked out on the page of candidates).
  @@index([hackathonId, closedAt, expiresAt, createdAt])
  @@index([authorId, hackathonId])
  @@index([roles], type: Gin)
  @@index([stack], type: Gin)
}

// The team space of a hackathon squad: a shared checklist (docs/SQUADS.md, "Team space").
model TeamChecklistItem {
  id          String    @id @default(cuid())
  teamId      String
  title       String
  assigneeId  String?
  done        Boolean   @default(false)
  doneAt      DateTime?
  createdById String
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  team      Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  assignee  User? @relation("ChecklistAssigned", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy User  @relation("ChecklistCreated", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([teamId, position])
}

// The idea board of a squad: members post ideas and vote; one can be marked chosen (it becomes the project's description and the demo post's).
model TeamIdea {
  id          String    @id @default(cuid())
  teamId      String
  authorId    String
  title       String
  description String?
  voteCount   Int       @default(0)
  chosenAt    DateTime?
  // Set when a moderator hid or removed it: it is left out of the board.
  moderatedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  team   Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  author User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  votes  TeamIdeaVote[]

  @@index([teamId, createdAt])
}

model TeamIdeaVote {
  id        String   @id @default(cuid())
  ideaId    String
  userId    String
  createdAt DateTime @default(now())

  idea TeamIdea @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ideaId, userId])
}

// Before a hackathon, each squad member confirms how they will take part. A member without one is flagged in squad strength.
model CommitmentPledge {
  id             String         @id @default(cuid())
  hackathonId    String
  teamId         String
  userId         String
  attendance     AttendanceMode
  hoursAvailable Int
  availableFrom  DateTime       @db.Date
  availableUntil DateTime       @db.Date
  confirmedAt    DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  hackathon Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([hackathonId, userId])
  @@index([teamId])
}

// After a hackathon, each squad member privately reviews each teammate, once. Nobody but an admin ever sees a review (the note least of all); what
// they add up to is UserReliability. `counted` is false for a review from an account the trust gate does not trust (src/lib/trust.ts): it is kept,
// and changes nothing.
model PeerReview {
  id              String   @id @default(cuid())
  hackathonId     String
  teamId          String?
  reviewerId      String
  revieweeId      String
  showedUp        ShowedUp
  wouldBuildAgain Boolean
  // Visible to admins only.
  note            String?
  counted         Boolean  @default(true)
  // How much the review counts toward reliability: 1 unless the collusion job lowered it (src/lib/integrity).
  integrityWeight Float    @default(1)
  createdAt       DateTime @default(now())

  hackathon Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  reviewer  User      @relation("PeerReviewsGiven", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewee  User      @relation("PeerReviewsReceived", fields: [revieweeId], references: [id], onDelete: Cascade)

  @@unique([hackathonId, reviewerId, revieweeId])
  @@index([revieweeId, createdAt])
  // What two people said about each other (chemistry, "never again").
  @@index([reviewerId, revieweeId])
}

// A person's reliability as a teammate (src/lib/squads/reliability.ts), recomputed from their counted reviews whenever one arrives. Never shown as a
// number; `badge` is the passport's "Reliable teammate".
model UserReliability {
  userId    String   @id
  score     Float
  reviews   Int
  badge     Boolean  @default(false)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// --- Integrity (src/lib/integrity, docs/SAFETY.md) ---------------------------------------------------------------------

enum FraudSignalStatus {
  // Found by the job; its down-weighting is in force.
  OPEN
  // An admin agreed. The down-weighting stays.
  CONFIRMED
  // An admin disagreed. Every weight it lowered is restored, and the same group is not flagged again.
  DISMISSED
}

// A group of accounts the nightly collusion job found boosting each other (src/lib/integrity/collusion.ts): a dense cluster of reciprocal endorsements,
// Props, connection accepts, peer reviews and team accepts, dominated by young or low-proof accounts. It lowers the weight of what they gave each other and
// feeds their risk scores. It never bans anyone and never deletes anything.
model FraudSignal {
  id           String            @id @default(cuid())
  type         String
  // 0 to 100.
  score        Int
  memberIds    String[]
  // What was seen: counts per kind of interaction, density, the members' ages and proof. Ids only, never content.
  evidence     Json
  // The rows whose weight it lowered, so a dismissal can restore exactly those: { props: [], endorsements: [], peerReviews: [] }.
  affected     Json              @default("{}")
  // Sorted member ids, hashed: the same group is one signal, updated by later runs.
  fingerprint  String
  status       FraudSignalStatus @default(OPEN)
  windowStart  DateTime
  windowEnd    DateTime
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([type, fingerprint])
  @@index([status, createdAt])
  @@index([memberIds], type: Gin)
}

enum RiskLevel {
  LOW
  ELEVATED
  HIGH
}

// A person's risk score (src/lib/integrity/risk.ts), recomputed nightly from their signals. HIGH reduces their reach (drops, feed, squad builder) and
// tightens their rate limits; every change is written to AuditEvent and an admin can override the level either way.
model UserRisk {
  userId         String     @id
  // 0 to 100.
  score          Int
  level          RiskLevel
  // The parts of the score, by factor: { collusion, reports, blocks, throttles, velocity, unverified }.
  factors        Json       @default("{}")
  // Set by an admin: wins over the computed level until cleared.
  overrideLevel  RiskLevel?
  overrideById   String?
  overrideReason String?
  computedAt     DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([level])
  @@index([overrideLevel])
}

// --- Privacy (src/lib/privacy, docs/PRIVACY.md) ---------------------------------------------------------------------

enum DataExportStatus {
  PENDING
  READY
  FAILED
  // The file was deleted after 24 hours.
  EXPIRED
}

// A person's request for a copy of their data (GET /api/users/me/export). A job builds the JSON file into the bucket; the download link is a signed URL
// that lasts as long as the file (24 hours), after which the retention job deletes the file and marks the row EXPIRED.
model DataExport {
  id          String           @id @default(cuid())
  userId      String
  status      DataExportStatus @default(PENDING)
  storageKey  String?
  bytes       Int?
  expiresAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, expiresAt])
}

enum ConsentType {
  TERMS
  PRIVACY
  // The romance mode processes special-category data (gender and who someone is interested in reveal sexual orientation): explicit consent is required.
  ROMANCE_MODE
  MARKETING
}

// Each consent a person gave, and its withdrawal: an append-only record (src/lib/privacy/consent.ts). The current state of a type is its latest row.
model ConsentRecord {
  id          String      @id @default(cuid())
  userId      String
  type        ConsentType
  // The version of the document agreed to, e.g. "2026-10-01".
  version     String
  grantedAt   DateTime    @default(now())
  withdrawnAt DateTime?
  // Where it was given: onboarding, settings, romance-optin, api.
  source      String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, grantedAt])
}

// --- Notification delivery (src/lib/notify, docs/NOTIFICATIONS.md) ---------------------------------------------------------

enum DeliveryChannel {
  EMAIL
  PUSH
}

enum DeliveryStatus {
  // Held until sendAfter: quiet hours, or a failed attempt that is worth another.
  DEFERRED
  SENT
  // Not sent, on purpose: `reason` says why (a rate limit, a duplicate, an address that bounced, no consent).
  SKIPPED
  // Not sent, and will not be: the provider refused it.
  FAILED
}

// A browser that agreed to receive web push (POST /api/notifications/push/subscriptions). The endpoint is the push service's address for that browser; p256dh and auth
// are the keys the payload is encrypted to, so they are secrets and are never returned or exported.
model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  endpoint   String    @unique @db.Text
  p256dh     String
  auth       String
  // A short label for the device in settings ("Chrome on macOS"), from the User-Agent when it was registered.
  label      String?
  failures   Int       @default(0)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// How a person wants to be reached, apart from which kinds (ChannelPreference). One row per person, made by the first change. Everything defaults to on:
// the rows that say otherwise are what people chose.
model NotificationSettings {
  userId             String    @id
  // The global switches. Switching email off is also what "unsubscribe from all" does; only account and safety notices still come (src/lib/notify/policy.ts).
  emailEnabled       Boolean   @default(true)
  pushEnabled        Boolean   @default(true)
  // Quiet hours in the person's own time zone: nothing is pushed or mailed then (except account and safety notices), it waits until they end.
  quietEnabled       Boolean   @default(true)
  // Minutes after local midnight: 1320 is 22:00, 480 is 08:00.
  quietStart         Int       @default(1320)
  quietEnd           Int       @default(480)
  dailyDigest        Boolean   @default(true)
  weeklyDigest       Boolean   @default(true)
  // When the last digest of each kind was sent: the marker that makes a digest once a local day or week.
  lastDailyDigestAt  DateTime?
  lastWeeklyDigestAt DateTime?
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// A person's choice for one kind on one channel, where it differs from the kind's default (src/lib/notify/policy.ts). No row: the default.
model ChannelPreference {
  id        String          @id @default(cuid())
  userId    String
  kind      String
  channel   DeliveryChannel
  enabled   Boolean
  updatedAt DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, channel])
}

// What the pipeline did with one notification (or digest) on one channel. The unique key is what makes a retry or a repeated sweep harmless, and the rows are what the
// rate limits count and the metrics read (docs/METRICS.md). `openedAt` is the click-through: a tap on the push or a click on a link in the email.
model NotificationDelivery {
  id             String          @id @default(cuid())
  userId         String
  // Null for a digest.
  notificationId String?
  // The delivery kind (src/lib/notify/policy.ts): a notification kind, or DIGEST_DAILY / DIGEST_WEEKLY.
  kind           String
  channel        DeliveryChannel
  status         DeliveryStatus
  reason         String?
  // What this delivery is of: the notification's coalescing key or id, or the digest's period. Unique per person and channel.
  dedupeKey      String
  // The email provider's id of the message, which its bounce and complaint events refer to.
  providerId     String?
  attempts       Int             @default(0)
  sendAfter      DateTime?
  sentAt         DateTime?
  openedAt       DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification Notification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)

  @@unique([userId, channel, dedupeKey])
  // Held deliveries that are due.
  @@index([status, sendAfter])
  // The rate limits: what was sent to this person on this channel lately.
  @@index([userId, channel, sentAt])
  @@index([providerId])
  // Retention and the open-rate metrics.
  @@index([createdAt])
}

// An address mail to which bounced or was complained about (POST /api/webhooks/email). Mail is never sent to it again. Kept by address, not by person: an account that
// is deleted and a new one made on the same address must not start mailing a dead mailbox or somebody who reported us. Lower-cased.
model EmailSuppression {
  id        String   @id @default(cuid())
  email     String   @unique
  // BOUNCE (the mailbox does not exist, or refuses us for good) or COMPLAINT (the person marked a message as spam).
  reason    String
  createdAt DateTime @default(now())
}

// --- Invites and campuses (src/lib/invites, src/lib/campus, docs/INVITES.md) ----------------------------------------------

enum InviteKind {
  // One per person, theirs to share: redeeming it can earn them XP.
  PERSONAL
  // Made by an admin for a launch waitlist or a partner college: attribution only, no XP.
  CAMPAIGN
}

enum InviteStatus {
  // The code was redeemed; the invitee has not yet finished onboarding and done something real.
  PENDING
  // Onboarding and a first real action are done. For a campaign code that is the end. For a personal one the inviter's XP is paid next, when the checks pass.
  QUALIFIED
  // The inviter was paid.
  REWARDED
  // Not counted, and `reason` says why (the same person, the same mailbox, a high risk account...).
  REJECTED
  // The invitee never qualified within 30 days.
  EXPIRED
}

model InviteCode {
  id          String     @id @default(cuid())
  // Eight characters from an alphabet without the ones that look alike (no 0 O 1 I L), upper case.
  code        String     @unique
  kind        InviteKind
  // PERSONAL only: whose code it is. One each.
  ownerId     String?    @unique
  // CAMPAIGN only: what it is for ("Waitlist wave 1", "IISc"), shown to admins.
  label       String?
  // A campus this code suggests to the people who join with it (they still verify it with a campus e-mail).
  campusId    String?
  // Null: unlimited.
  maxUses     Int?
  uses        Int        @default(0)
  expiresAt   DateTime?
  disabledAt  DateTime?
  // The admin who made a campaign code.
  createdById String?
  createdAt   DateTime   @default(now())

  owner       User?              @relation("InviteOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  campus      Campus?            @relation(fields: [campusId], references: [id], onDelete: SetNull)
  redemptions InviteRedemption[]

  @@index([kind, createdAt])
  @@index([campusId])
}

// Who joined with which code: one row per invitee, ever (an account has one attribution).
model InviteRedemption {
  id          String       @id @default(cuid())
  codeId      String
  inviteeId   String       @unique
  // PERSONAL: the owner of the code. Null for a campaign code, and once that person's account is deleted.
  inviterId   String?
  status      InviteStatus @default(PENDING)
  // Why REJECTED, or why a QUALIFIED one is waiting (WAITING_TRUST, CAP).
  reason      String?
  redeemedAt  DateTime     @default(now())
  qualifiedAt DateTime?
  rewardedAt  DateTime?

  code    InviteCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  invitee User       @relation("InviteeOf", fields: [inviteeId], references: [id], onDelete: Cascade)
  inviter User?      @relation("InviterOf", fields: [inviterId], references: [id], onDelete: SetNull)

  @@index([codeId])
  @@index([inviterId, status])
  // The qualification job: what is still open, oldest first.
  @@index([status, redeemedAt])
}

// A college or university, managed by admins. A person is on its leaderboard and its feed once they verify a campus e-mail address of it.
model Campus {
  id           String    @id @default(cuid())
  // The comparable key: what Profile.campusKey holds and what the campus leaderboard is called (lower case letters, digits and hyphens).
  slug         String    @unique
  name         String
  // The domains its e-mail addresses are on ("iisc.ac.in"); a subdomain of one counts.
  emailDomains String[]  @default([])
  city         String?
  cityKey      String?
  // ISO 3166-1 alpha-2.
  countryCode  String?
  // A disabled campus takes no new members; the ones it has keep their place.
  disabledAt   DateTime?
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  memberships CampusMembership[]
  invites     InviteCode[]

  @@index([emailDomains], type: Gin)
  @@index([countryCode])
}

// Who verified which campus. PRIVATE: the e-mail address is not kept, only a keyed hash of it, which is enough to stop one campus mailbox from verifying two accounts
// and cannot be turned back into the address. Never shown to anyone, other people's views of a profile included.
model CampusMembership {
  userId     String   @id
  campusId   String
  emailHash  String   @unique
  verifiedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  campus Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)

  @@index([campusId])
}

// A campus e-mail verification in progress: the code that was sent. The address is kept here only until the code is confirmed or expires, then it is erased. One per person.
model CampusVerification {
  userId    String   @id
  campusId  String
  // PRIVATE. Cleared when verified or after it expires.
  email     String?
  emailHash String
  // A keyed hash of the six-digit code.
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}
