generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum VerificationLevel {
  NONE
  EMAIL
  PHONE
  GITHUB
  PORTFOLIO
  ORGANIZATION
  IDENTITY
}

enum ConnectionType {
  TEAMMATE
  COLLABORATOR
  MENTOR
  FRIEND
  NETWORK
  DATING
}

enum ProjectStatus {
  IDEA
  PLANNING
  BUILDING
  TESTING
  SHIPPED
  ARCHIVED
}

// What a person can be looking for in the matching engine (src/lib/matching). MENTOR and MENTEE are the two sides of one
// relationship; the others pair with themselves. DATING is separate: it never mixes with the rest, in either direction.
enum MatchType {
  COFOUNDER
  HACKATHON_TEAMMATE
  COLLABORATOR
  MENTOR
  MENTEE
  DATING
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
}

enum TeamApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
  // An invitation nobody answered within its 48 hours (src/lib/squads/lifecycle.ts).
  EXPIRED
}

// The fixed role catalogue of a squad (docs/SQUADS.md): what an open slot asks for and what a member says they do on the team. OTHER carries a
// customLabel ("Smart contract developer").
enum SquadRole {
  FRONTEND
  BACKEND
  FULLSTACK
  MOBILE
  ML_AI
  DATA
  DEVOPS
  DESIGN_UI_UX
  PRODUCT
  PITCH_BUSINESS
  HARDWARE
  OTHER
}

enum SlotStatus {
  OPEN
  FILLED
}

enum HackathonStatus {
  UPCOMING
  ACTIVE
  ENDED
  CANCELLED
}

enum HackathonParticipantStatus {
  REGISTERED
  TEAM_FORMED
  SUBMITTED
  WITHDRAWN
}

enum ChallengeCategory {
  CODING
  AI
  DESIGN
  PRODUCT
  LOGIC
  CYBERSECURITY
  ENTREPRENEURSHIP
  COMMUNICATION
  PROBLEM_SOLVING
}

enum ChallengeDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum NotificationType {
  NEW_MESSAGE
  TEAM_INVITATION
  JOIN_REQUEST
  HACKATHON_REMINDER
  PROJECT_UPDATE
  ACHIEVEMENT
  CHALLENGE_COMPLETION
  CONNECTION
  MENTION
  APPLICATION_RESPONSE
  SYSTEM
  MATCH
  // Social: props on a post, a comment or reply, a new follower, a post on a project the person watches (src/lib/notifications.ts coalesces them).
  PROPS
  COMMENT
  FOLLOW
  WATCH
  // Somebody sparked you: one per spark for a plan that shows who, one daily count for one that does not (src/lib/matching/spark-digest.ts).
  SPARK
}

enum ReportReason {
  SPAM
  HARASSMENT
  INAPPROPRIATE_CONTENT
  FAKE_PROFILE
  SCAM
  COPYRIGHT
  OTHER
  // A person asking for their own locked date of birth to be corrected (the report is filed against themselves; an admin decides).
  BIRTHDATE_CORRECTION
}

enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  DISMISSED
}

model User {
  id                   String            @id @default(cuid())
  // Clerk user id. Null for legacy rows (seeded demo users, accounts created
  // before the move to Clerk) until they are linked on a verified email.
  clerkId              String?           @unique
  email                String            @unique
  emailVerified        DateTime?
  passwordHash         String?
  name                 String?
  username             String            @unique
  image                String?
  bio                  String?
  headline             String?
  location             String?
  timezone             String?
  availability         String?
  builderRole          String?
  website              String?
  githubUsername       String?           @unique
  twitterUsername      String?           @unique
  linkedinUrl          String?
  role                 UserRole          @default(USER)
  verificationLevel    VerificationLevel @default(NONE)
  isEmailVerified      Boolean           @default(false)
  isPhoneVerified      Boolean           @default(false)
  githubConnected      Boolean           @default(false)
  portfolioVerified    Boolean           @default(false)
  organizationVerified Boolean           @default(false)
  identityVerified     Boolean           @default(false)
  xp                   Int               @default(0)
  rank                 Int               @default(0)
  reputationScore      Int               @default(0)
  lastActiveAt         DateTime          @default(now())
  // PRIVATE. Only ever read to check that someone is 18 or older for DATING, and returned to nobody but the owner on
  // their own profile read (GET /api/users/me/profile). Set once and then locked. Wiped when the account is deleted.
  birthDate            DateTime?         @db.Date
  // Set when the person gave a date of birth that makes them younger than the platform minimum (src/lib/age-policy.ts). NOTHING else about it is
  // kept, not the date: the account is closed to everything but asking for a correction, and an admin correction (which clears this) is the only way back.
  birthDateRefusedAt   DateTime?
  // What the user wears: { title, frame, banner }, each the slug of a cosmetic they own (or absent).
  equipped             Json              @default("{}")
  // Streak (see src/lib/streaks.ts). A day counts when the user earned XP from an action of their
  // own that local day. lastStreakDay is that local date, "YYYY-MM-DD", in the user's time zone then.
  currentStreak        Int               @default(0)
  longestStreak        Int               @default(0)
  lastStreakDay        String?
  // Banked freezes, at most 2: a single missed day spends one instead of ending the streak.
  streakFreezes        Int               @default(0)
  // A freeze was spent during the current run (reset when a run starts over).
  streakFreezeUsed     Boolean           @default(false)
  // Set when the Clerk account is deleted. The row is kept and anonymised so
  // the content other people depend on survives (see docs/AUTH_MIGRATION.md).
  deletedAt            DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  accounts            Account[]
  sessions            Session[]
  profile             Profile?
  skills              UserSkill[]
  skillEvidences      SkillEvidence[]
  projects            ProjectMember[]
  ownedProjects       Project[]                @relation("ProjectOwner")
  teams               TeamMember[]
  ownedTeams          Team[]                   @relation("TeamOwner")
  teamApplications    TeamApplication[]
  teamInvitationsSent TeamApplication[]        @relation("TeamInvitationsSent")
  blocksMade          Block[]                  @relation("BlocksMade")
  blocksReceived      Block[]                  @relation("BlocksReceived")
  hackathons          HackathonParticipant[]
  hackathonTeams      HackathonTeamMember[]
  teamSlotsFilled     TeamSlot[]               @relation("TeamSlotsFilled")
  challenges          ChallengeAttempt[]
  achievements        UserAchievement[]
  xpEvents            XPEvent[]
  reputationEvents    ReputationEvent[]
  sentConnections     Connection[]             @relation("SentConnections")
  receivedConnections Connection[]             @relation("ReceivedConnections")
  conversations       ConversationMember[]
  messages            Message[]
  messageReactions    MessageReaction[]
  messageReads        MessageRead[]
  notifications       Notification[]
  reports             Report[]                 @relation("ReportsSubmitted")
  reportedReports     Report[]                 @relation("ReportsAgainst")
  moderationActions   ModerationAction[]
  auditEvents         AuditEvent[]
  verifications       Verification[]
  currentBuild        CurrentBuild?
  projectUpdates      ProjectUpdate[]
  userQuests          UserQuest[]
  activities          Activity[]
  leaderboardEntries  LeaderboardEntry[]
  subscription        Subscription?
  productEvents       ProductEvent[]
  seasonStandings     SeasonStanding[]
  counters            UserCounter[]
  progressTicks       ProgressTick[]
  cosmetics           UserCosmetic[]
  matchingProfile     MatchingProfile?
  drops               Drop[]                   @relation("DropsReceived")
  dropsShown          Drop[]                   @relation("DropsShown")
  sparksSent          Spark[]                  @relation("SparksSent")
  sparksReceived      Spark[]                  @relation("SparksReceived")
  matchesAsA          Match[]                  @relation("MatchesAsA")
  matchesAsB          Match[]                  @relation("MatchesAsB")
  notificationPrefs   NotificationPreference[]
  mediaAssets         MediaAsset[]
  posts               ShipPost[]
  props               Prop[]
  comments            Comment[]
  following           Follow[]                 @relation("Following")
  followers           Follow[]                 @relation("Followers")
  watches             Watch[]
  romanceProfile      RomanceProfile?
  romanceDrops        RomanceDrop[]            @relation("RomanceDropsReceived")
  romanceDropsShown   RomanceDrop[]            @relation("RomanceDropsShown")
  duosAsA             Duo[]                    @relation("DuoAsA")
  duosAsB             Duo[]                    @relation("DuoAsB")

  // "Users active in the last 30 days" is the denominator of every achievement's rarity.
  @@index([lastActiveAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Profile {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline             String?
  bio                  String?  @db.Text
  location             String?
  timezone             String?
  availability         String?
  builderRole          String?
  website              String?
  githubUrl            String?
  portfolioUrl         String?
  linkedinUrl          String?
  twitterUrl           String?
  showEmail            Boolean  @default(false)
  showLocation         Boolean  @default(true)
  showAvailability     Boolean  @default(true)
  // Where the person is, for the country, city and campus leaderboards (see src/lib/places.ts).
  // countryCode is ISO 3166-1 alpha-2. city and campus hold tidied free text; the *Key columns
  // hold the comparable form ("São Paulo" -> "sao-paulo"), and are what the boards group by.
  countryCode          String?
  city                 String?
  cityKey              String?
  campus               String?
  campusKey            String?
  // Privacy. Opting out of leaderboards removes the person from every board and from every rank
  // others can see; hiding activity keeps the contribution heatmap to themselves.
  hideFromLeaderboards Boolean  @default(false)
  showActivity         Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([countryCode])
  @@index([countryCode, cityKey])
  @@index([campusKey])
}

model Skill {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  category    String
  subcategory String?
  description String?  @db.Text
  icon        String?
  color       String?
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userSkills     UserSkill[]
  skillEvidences SkillEvidence[]
}

model UserSkill {
  id              String   @id @default(cuid())
  userId          String
  skillId         String
  level           Int      @default(1) // 1-5
  isVerified      Boolean  @default(false)
  yearsExperience Float?   @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  // Who has a skill: the matching pool ranks candidates by the skills a viewer is looking for.
  @@index([skillId])
}

model SkillEvidence {
  id          String    @id @default(cuid())
  userId      String
  skillId     String
  type        String // CHALLENGE, GITHUB_PROJECT, HACKATHON_PROJECT, CONTRIBUTION, PEER_ENDORSEMENT, PORTFOLIO, CERTIFICATION, CONNECTED_PROFILE
  title       String
  description String?   @db.Text
  url         String?
  metadata    Json?
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)
}

model Project {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String?       @db.Text
  shortDesc   String?
  status      ProjectStatus @default(IDEA)
  ownerId     String
  hackathonId String?
  githubUrl   String?
  demoUrl     String?
  websiteUrl  String?
  thumbnail   String?
  isPublic    Boolean       @default(true)
  teamSize    Int           @default(1)
  maxTeamSize Int           @default(5)
  lookingFor  String[]      @default([])
  techStack   String[]      @default([])
  startedAt   DateTime?
  shippedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  owner        User            @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members      ProjectMember[]
  hackathon    Hackathon?      @relation(fields: [hackathonId], references: [id], onDelete: SetNull)
  team         Team?
  updates      ProjectUpdate[]
  milestones   Milestone[]
  chat         Chat?
  conversation Conversation?
  activities   Activity[]
  posts        ShipPost[]
  watchers     Watch[]
}

model ProjectMember {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  role      String   @default("MEMBER")
  joinedAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([projectId])
}

model ProjectUpdate {
  id        String   @id @default(cuid())
  projectId String
  authorId  String
  title     String
  content   String   @db.Text
  type      String   @default("UPDATE") // UPDATE, MILESTONE, SHIPPED, ANNOUNCEMENT
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model Milestone {
  id          String    @id @default(cuid())
  projectId   String
  title       String
  description String?   @db.Text
  dueDate     DateTime?
  completedAt DateTime?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Team {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String?  @db.Text
  projectId    String?  @unique
  hackathonId  String?
  ownerId      String
  maxSize      Int      @default(5)
  isRecruiting Boolean  @default(true)
  // DERIVED from the open slots (src/lib/squads/roles.ts derivedLookingFor), rewritten with every slot change, so clients and code that read it keep
  // working. A write to it from an old client is turned into OTHER slots.
  lookingFor   String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  owner          User              @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members        TeamMember[]
  slots          TeamSlot[]
  applications   TeamApplication[]
  project        Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  hackathon      Hackathon?        @relation(fields: [hackathonId], references: [id], onDelete: SetNull)
  hackathonTeams HackathonTeam[]
  chat           Chat?
  conversation   Conversation?
}

model TeamMember {
  id        String     @id @default(cuid())
  userId    String
  teamId    String
  // Permissions on the team (owner, admin, member). What the person DOES on the squad is squadRole.
  role      TeamRole   @default(MEMBER)
  squadRole SquadRole?
  // Only for squadRole OTHER.
  roleLabel String?
  joinedAt  DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([teamId])
}

model TeamApplication {
  id          String                @id @default(cuid())
  userId      String
  teamId      String
  message     String?               @db.Text
  status      TeamApplicationStatus @default(PENDING)
  // Null (the default) means this is a self-initiated application, reviewed
  // by the team owner/admin as before. Set means the OWNER invited this
  // user directly - the accept/decline authorization flips to the invitee
  // (userId), not the team, since they're the one being asked. Everything
  // else about the row (the unique[userId,teamId] constraint, the accept
  // transaction, the maxSize guard) is shared and unchanged either way.
  invitedById String?
  // The open slot this application or invitation is for; accepting fills it.
  slotId      String?
  // Invitations expire (48h); applications do not (null).
  expiresAt   DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("TeamInvitationsSent", fields: [invitedById], references: [id], onDelete: SetNull)
  slot      TeamSlot? @relation(fields: [slotId], references: [id], onDelete: SetNull)

  @@unique([userId, teamId])
  @@index([teamId])
  // The expiry sweep.
  @@index([status, expiresAt])
}

// One open (or filled) position on a team: a role from the catalogue and the skills it needs. Accepting an application or invitation for it fills
// it; the member leaving reopens it.
model TeamSlot {
  id             String     @id @default(cuid())
  teamId         String
  role           SquadRole
  // Only for OTHER: what the role is called.
  customLabel    String?
  // Skill names, as Team.lookingFor always held them.
  requiredSkills String[]   @default([])
  status         SlotStatus @default(OPEN)
  filledById     String?
  filledAt       DateTime?
  // Display order on the team.
  position       Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  team         Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  filledBy     User?             @relation("TeamSlotsFilled", fields: [filledById], references: [id], onDelete: SetNull)
  applications TeamApplication[]

  @@index([teamId, status])
  @@index([filledById])
}

model Hackathon {
  id                   String          @id @default(cuid())
  name                 String
  slug                 String          @unique
  description          String          @db.Text
  shortDesc            String?
  startDate            DateTime
  endDate              DateTime
  registrationDeadline DateTime?
  // When member changes stop (the team locks). Null: the end date.
  submissionDeadline   DateTime?
  status               HackathonStatus @default(UPCOMING)
  organizer            String?
  websiteUrl           String?
  prizePool            String?
  rules                String?         @db.Text
  technologies         String[]        @default([])
  maxTeamSize          Int             @default(5)
  minTeamSize          Int             @default(1)
  location             String? // ONLINE, HYBRID, or physical location
  isPublic             Boolean         @default(true)
  thumbnail            String?
  banner               String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  participants   HackathonParticipant[]
  hackathonTeams HackathonTeam[]
  projects       Project[]
  teams          Team[]
  currentBuilds  CurrentBuild[]
  chat           Chat?
  conversation   Conversation?
}

model HackathonParticipant {
  id           String                     @id @default(cuid())
  userId       String
  hackathonId  String
  status       HackathonParticipantStatus @default(REGISTERED)
  teamId       String?
  registeredAt DateTime                   @default(now())
  // When they joined the squad they are in for this hackathon (time-to-team, the admin metric).
  teamJoinedAt DateTime?
  skills       String[]                   @default([])
  lookingFor   String[]                   @default([])

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  hackathon Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)

  @@unique([userId, hackathonId])
  @@index([hackathonId, teamId])
}

model HackathonTeam {
  id          String   @id @default(cuid())
  hackathonId String
  teamId      String   @unique
  name        String
  projectId   String?
  rank        Int?
  score       Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hackathon Hackathon             @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  team      Team                  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  members   HackathonTeamMember[]
}

model HackathonTeamMember {
  id              String   @id @default(cuid())
  hackathonTeamId String
  userId          String
  role            String   @default("MEMBER")
  joinedAt        DateTime @default(now())

  hackathonTeam HackathonTeam @relation(fields: [hackathonTeamId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([hackathonTeamId, userId])
}

model Challenge {
  id          String              @id @default(cuid())
  title       String
  slug        String              @unique
  description String              @db.Text
  category    ChallengeCategory
  difficulty  ChallengeDifficulty
  xpReward    Int                 @default(100)
  repoUrl     String?
  starterCode String?             @db.Text
  tests       Json?
  tags        String[]            @default([])
  isActive    Boolean             @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  attempts ChallengeAttempt[]
}

model ChallengeAttempt {
  id          String    @id @default(cuid())
  userId      String
  challengeId String
  code        String?   @db.Text
  language    String?
  status      String    @default("PENDING") // PENDING, PASSED, FAILED, RUNNING
  score       Int?
  output      String?   @db.Text
  passedTests Int       @default(0)
  totalTests  Int       @default(0)
  timeSpent   Int       @default(0) // seconds
  submittedAt DateTime  @default(now())
  completedAt DateTime?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
}

model Achievement {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  description     String    @db.Text
  icon            String?
  category        String
  xpReward        Int       @default(0)
  criteria        Json // { type, conditions }
  isSecret        Boolean   @default(false)
  order           Int       @default(0)
  // The share of users active in the last 30 days who have earned it, 0 to 1 (smaller is rarer).
  // Null until the nightly job (achievements/rarity) has run once.
  rarity          Float?
  rarityUpdatedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  earnedAt      DateTime @default(now())
  progress      Json? // { current, target } as it stood when it was earned

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

// How many times a user has done something that counts toward achievements and quests, one row per
// kind of thing (the metrics in src/lib/metrics.ts). It only ever goes up, and only through
// recordTick, which also writes the ProgressTick that makes each increment happen once.
model UserCounter {
  id        String   @id @default(cuid())
  userId    String
  key       String
  value     Int      @default(0)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

// One counted thing: "this user shipped this project". The unique key on (userId, metric, dedupeKey)
// is what makes a repeated event (un-endorsing and endorsing again, a retry) count once, and the
// timestamps answer the questions about a week ("three ships in one week").
model ProgressTick {
  id        String   @id @default(cuid())
  userId    String
  metric    String
  dedupeKey String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, metric, dedupeKey])
  @@index([userId, metric, createdAt])
}

enum CosmeticType {
  TITLE
  FRAME
  BANNER
  // Worn in the "badges" slot, up to three at a time.
  BADGE
  AVATAR_PART
}

enum CosmeticRarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
}

// Something a person shows on their profile: a title, a frame, a banner, a piece of avatar. They are only
// ever EARNED, by a rule in unlockRule (a tier, an achievement, a streak): nothing here has a price and no
// route grants one. The catalog is in src/lib/cosmetic-definitions.ts and rows are created from it on first
// use, like achievements. src/lib/cosmetics.ts is the only code that writes a UserCosmetic.
model Cosmetic {
  id          String         @id @default(cuid())
  slug        String         @unique
  type        CosmeticType
  name        String
  description String         @db.Text
  rarity      CosmeticRarity @default(COMMON)
  // What unlocks it, e.g. { "type": "TIER", "tier": "GOLD" } or { "type": "ACHIEVEMENT", "slug": "ship-100" }.
  unlockRule  Json
  order       Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  userCosmetics UserCosmetic[]

  @@index([type])
}

// A cosmetic a user has earned (their inventory). `source` says which rule unlocked it.
model UserCosmetic {
  id         String   @id @default(cuid())
  userId     String
  cosmeticId String
  source     String
  unlockedAt DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cosmetic Cosmetic @relation(fields: [cosmeticId], references: [id], onDelete: Cascade)

  @@unique([userId, cosmeticId])
  @@index([userId])
}

model XPEvent {
  id          String   @id @default(cuid())
  userId      String
  type        String // The reward action: one of the keys of REWARD_RULES in src/lib/rewards-config.ts
  amount      Int
  description String
  metadata    Json?
  // The season being played when it was earned (see Season). Null for XP from before seasons began.
  seasonId    String?
  // What earned it (PROJECT, HACKATHON, ACHIEVEMENT, ...) and which row.
  sourceType  String?
  sourceId    String?
  // Identifies "the same award" for this user and action, so a retry or a race
  // cannot pay twice. Null on rows from before the rewards engine, which the
  // unique index below treats as distinct.
  dedupeKey   String?
  createdAt   DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  season Season? @relation(fields: [seasonId], references: [id], onDelete: SetNull)

  @@unique([userId, type, dedupeKey])
  @@index([userId, createdAt])
  @@index([userId, type, createdAt])
  // Leaderboards and the nightly reconcile add XP up over a time range or a season.
  @@index([createdAt])
  @@index([seasonId, userId])
}

// A fixed stretch of time with its own leaderboard. At most one is active (the rollover job closes
// one and opens the next in the same transaction). Every XPEvent is stamped with the season it was
// earned in, so a season's standings are always a sum over the log.
model Season {
  id               String    @id @default(cuid())
  number           Int       @unique
  name             String
  startsAt         DateTime
  endsAt           DateTime
  active           Boolean   @default(false)
  // Set when the rollover job has closed the season and written its final standings.
  closedAt         DateTime?
  // Set when the season's cosmetic rewards (title, frames, participation badge) have been granted. Null until then;
  // the rollover job grants them for every closed season that is still null.
  rewardsGrantedAt DateTime?
  createdAt        DateTime  @default(now())

  xpEvents  XPEvent[]
  standings SeasonStanding[]

  @@index([active])
}

// A season's final standing for one person, written once when the season closes. The season's cosmetic
// rewards (see src/lib/seasons.ts) are granted from this record; no XP is paid for a placing.
model SeasonStanding {
  id        String   @id @default(cuid())
  seasonId  String
  userId    String
  rank      Int
  score     Int
  createdAt DateTime @default(now())

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([seasonId, userId])
  @@index([seasonId, rank])
  @@index([userId])
}

model ReputationEvent {
  id          String   @id @default(cuid())
  userId      String
  type        String // PROJECT_SHIPPED, HACKATHON_PLACEMENT, CHALLENGE_COMPLETE, OSS_CONTRIBUTION, TEAM_ENDORSEMENT, PEER_ENDORSEMENT, SKILL_VERIFIED
  amount      Int
  sourceId    String? // Reference to project, hackathon, challenge, etc.
  sourceType  String? // PROJECT, HACKATHON, CHALLENGE, USER
  description String
  metadata    Json?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Connection {
  id         String         @id @default(cuid())
  senderId   String
  receiverId String
  type       ConnectionType @default(NETWORK)
  status     String         @default("PENDING") // PENDING, ACCEPTED, DECLINED, BLOCKED
  message    String?        @db.Text
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  sender   User @relation("SentConnections", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedConnections", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([receiverId])
}

model Conversation {
  id           String    @id @default(cuid())
  type         String    @default("DIRECT") // DIRECT, GROUP, PROJECT, TEAM, HACKATHON
  name         String?
  projectId    String?   @unique
  teamId       String?   @unique
  hackathonId  String?   @unique
  // Set when the conversation was closed for good (a match was ended): nobody can post in it any more, and it stays readable.
  closedAt     DateTime?
  closedReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  members   ConversationMember[]
  messages  Message[]
  chats     Chat[]
  match     Match?
  project   Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  team      Team?                @relation(fields: [teamId], references: [id], onDelete: SetNull)
  hackathon Hackathon?           @relation(fields: [hackathonId], references: [id], onDelete: SetNull)
}

model ConversationMember {
  id             String    @id @default(cuid())
  userId         String
  conversationId String
  role           String    @default("MEMBER") // MEMBER, ADMIN, OWNER
  joinedAt       DateTime  @default(now())
  lastReadAt     DateTime?
  isMuted        Boolean   @default(false)
  isPinned       Boolean   @default(false)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([userId, conversationId])
  @@index([conversationId])
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  content        String    @db.Text
  type           String    @default("TEXT") // TEXT, IMAGE, FILE, SYSTEM, CODE, LINK_PREVIEW
  replyToId      String?
  editedAt       DateTime?
  deletedAt      DateTime?
  metadata       Json?
  createdAt      DateTime  @default(now())

  conversation Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User              @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo      Message?          @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]         @relation("MessageReplies")
  reactions    MessageReaction[]
  reads        MessageRead[]

  @@index([conversationId, createdAt])
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
}

model MessageRead {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  readAt    DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
}

model Chat {
  id             String   @id @default(cuid())
  type           String // PROJECT, TEAM, HACKATHON
  projectId      String?  @unique
  teamId         String?  @unique
  hackathonId    String?  @unique
  conversationId String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project      Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  team         Team?        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  hackathon    Hackathon?   @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model Notification {
  id          String           @id @default(cuid())
  userId      String
  type        NotificationType
  title       String
  message     String           @db.Text
  link        String?
  metadata    Json?
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())
  // Notifications that stand for several events ("12 people gave Props to X") share a key within a time window; the row is updated, not repeated (src/lib/notifications.ts).
  coalesceKey String?
  count       Int              @default(1)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, coalesceKey])
  @@index([userId, isRead])
}

// Which kinds of notification a person has switched off (src/lib/notifications.ts). No row means the kind is on; a row says what they chose.
model NotificationPreference {
  id        String   @id @default(cuid())
  userId    String
  kind      String
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
}

model Report {
  id          String       @id @default(cuid())
  reporterId  String
  reportedId  String
  reason      ReportReason
  description String?      @db.Text
  status      ReportStatus @default(PENDING)
  metadata    Json?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  reporter User @relation("ReportsSubmitted", fields: [reporterId], references: [id], onDelete: Cascade)
  reported User @relation("ReportsAgainst", fields: [reportedId], references: [id], onDelete: Cascade)

  @@index([status])
}

model ModerationAction {
  id          String   @id @default(cuid())
  moderatorId String
  targetId    String
  targetType  String // USER, MESSAGE, PROJECT, TEAM, REPORT
  action      String // WARN, SUSPEND, BAN, DELETE, LOCK, UNLOCK
  reason      String   @db.Text
  duration    Int? // For temporary actions (in days)
  metadata    Json?
  createdAt   DateTime @default(now())

  moderator User @relation(fields: [moderatorId], references: [id], onDelete: Cascade)
}

model AuditEvent {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  targetType String
  targetId   String?
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Verification {
  id         String    @id @default(cuid())
  userId     String
  type       String // EMAIL, PHONE, GITHUB, PORTFOLIO, ORGANIZATION, IDENTITY
  status     String    @default("PENDING") // PENDING, VERIFIED, REJECTED, EXPIRED
  provider   String?
  providerId String?
  metadata   Json?
  verifiedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CurrentBuild {
  id          String        @id @default(cuid())
  userId      String        @unique
  title       String
  description String?       @db.Text
  status      ProjectStatus @default(BUILDING)
  progress    Int           @default(0) // 0-100
  techStack   String[]      @default([])
  teamSize    Int           @default(1)
  maxTeamSize Int           @default(5)
  rolesNeeded String[]      @default([])
  hackathonId String?
  githubUrl   String?
  demoUrl     String?
  isPublic    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  hackathon Hackathon? @relation(fields: [hackathonId], references: [id])

  @@index([hackathonId])
}

// A quest a user can be given: a small, useful thing to do inside a day or a week. The catalog is in
// src/lib/quest-definitions.ts and rows are created from it on first use (like achievements); which
// three daily and three weekly quests a person sees is decided by a hash of (user, period), not stored
// here. startsAt and endsAt are only for hand-made quests with a fixed window; a rotating quest has none.
model Quest {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  description   String    @db.Text
  type          String // DAILY, WEEKLY, SPECIAL
  criteria      Json // { metric, target } for the rotating quests
  xpReward      Int       @default(0)
  achievementId String?
  startsAt      DateTime?
  endsAt        DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  userQuests UserQuest[]
}

// One user's go at one quest in one period (a local day or week). Created when the first thing that
// counts toward it happens, so a row exists only for quests the user has started.
model UserQuest {
  id          String    @id @default(cuid())
  userId      String
  questId     String
  // The period it belongs to: the local date ("2026-10-16") for a daily quest, the ISO week ("2026-W42")
  // for a weekly one, in the user's time zone then.
  periodKey   String
  periodStart DateTime
  periodEnd   DateTime
  progress    Json // { current, target, completed }
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest Quest @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@unique([userId, questId, periodKey])
  @@index([userId, periodEnd])
}

model Activity {
  id          String   @id @default(cuid())
  userId      String
  type        String // PROJECT_SHIPPED, HACKATHON_JOINED, HACKATHON_WON, CHALLENGE_COMPLETED, TEAM_JOINED, ACHIEVEMENT_EARNED, OSS_RELEASED, MILESTONE_REACHED
  title       String
  description String?  @db.Text
  link        String?
  metadata    Json?
  createdAt   DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId String?

  @@index([userId, createdAt])
}

// One user blocking another. Directional (A blocks B is not B blocks A), but
// enforcement is symmetric: neither side can message, connect, invite or
// apply to the other while either direction exists.
model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  reason    String?
  createdAt DateTime @default(now())

  blocker User @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model Leaderboard {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  type        String // GLOBAL, HACKATHON, TECHNICAL, SHIPPING, RISING, CHALLENGE
  period      String // ALL_TIME, MONTHLY, WEEKLY, DAILY
  hackathonId String?
  criteria    Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entries LeaderboardEntry[]
}

model LeaderboardEntry {
  id            String   @id @default(cuid())
  leaderboardId String
  userId        String
  rank          Int
  score         Int
  metadata      Json?
  calculatedAt  DateTime @default(now())

  leaderboard Leaderboard @relation(fields: [leaderboardId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([leaderboardId, userId])
}

enum SubscriptionPlan {
  FREE
  PRO
  CREW_PRO
  ORG
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  EXPIRED
}

// What a user is entitled to (see src/lib/entitlements.ts). A user without a row
// is on FREE. provider and providerRef are reserved for the billing integration
// and are not written by anything yet.
model Subscription {
  id               String             @id @default(cuid())
  userId           String             @unique
  plan             SubscriptionPlan   @default(FREE)
  status           SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd DateTime?
  provider         String?
  providerRef      String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([provider, providerRef])
}

// Runtime switches (see src/lib/flags.ts). A user is in when they are on the
// allowlist, or the flag is enabled and their stable hash falls under rolloutPercent.
model FeatureFlag {
  id             String   @id @default(cuid())
  key            String   @unique
  description    String?
  enabled        Boolean  @default(false)
  rolloutPercent Int      @default(100)
  allowUserIds   String[] @default([])
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Product analytics (see src/lib/infra/analytics.ts). props never holds personal data.
// userId is set to null when the user is deleted, so the counts survive but the link does not.
model ProductEvent {
  id        String   @id @default(cuid())
  name      String
  userId    String?
  props     Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([name, createdAt])
  @@index([userId, name])
}

// How a person wants to be matched (src/lib/matching). One row per user, created by the first PUT /api/matching/profile.
model MatchingProfile {
  id               String      @id @default(cuid())
  userId           String      @unique
  // Never empty once saved. DATING is only ever present for someone who passed the dating gate (src/lib/matching/dating.ts).
  connectionTypes  MatchType[]
  // [{ tag, hackathonId?, expiresAt? }], at most 10.
  intentTags       Json        @default("[]")
  hoursPerWeek     Int?
  availableFrom    DateTime?   @db.Date
  remoteOk         Boolean     @default(true)
  // Only match with people in the same city (Profile.cityKey).
  cityOnly         Boolean     @default(false)
  // Skill slugs.
  lookingForSkills String[]    @default([])
  // Answers to the fixed working-style quiz: { questionId: optionId }.
  workingStyle     Json        @default("{}")
  // "HH:MM" in the person's own time zone: when their daily drops arrive.
  dropTimeLocal    String      @default("09:00")
  paused           Boolean     @default(false)
  // The local date ("YYYY-MM-DD", in their zone then) that drops were last generated for, so a day is generated once.
  lastDropDate     String?
  // When the daily "N people sparked you" notification was last sent, so it is sent once a local day and counts only the sparks since.
  sparkDigestAt    DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([paused, dropTimeLocal])
  @@index([connectionTypes], type: Gin)
}

enum DropStatus {
  NEW
  SPARKED
  PASSED
  EXPIRED
}

// One person shown to another for one local day (src/lib/matching/drops.ts). `userId` is who it is for, `candidateId` who they are shown.
// A person is shown to someone at most once a day (the unique key), and `connectionType` is the relationship from the VIEWER's side.
model Drop {
  id             String     @id @default(cuid())
  userId         String
  candidateId    String
  connectionType MatchType
  // 0 to 100, from src/lib/matching/score.ts, and the (at most three) lines that explain it.
  score          Int
  reasons        Json       @default("[]")
  // The viewer's own calendar day the drop belongs to, "YYYY-MM-DD" in their time zone then.
  localDate      String
  status         DropStatus @default(NEW)
  // Resurfaced from a pass because the person has grown since (src/lib/matching/second-look.ts).
  secondLook     Boolean    @default(false)
  // What the candidate looked like when the viewer passed: { tier, verifiedEvidence }. The second look compares against it.
  passSnapshot   Json?
  // The end of the viewer's local day.
  expiresAt      DateTime
  viewedAt       DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  user      User    @relation("DropsReceived", fields: [userId], references: [id], onDelete: Cascade)
  candidate User    @relation("DropsShown", fields: [candidateId], references: [id], onDelete: Cascade)
  sparks    Spark[]

  @@unique([userId, candidateId, localDate])
  // Today's drops, and "was this person shown or passed lately" for one viewer.
  @@index([userId, localDate])
  @@index([userId, candidateId, createdAt])
  // How often a candidate has been shown today (the fairness cap).
  @@index([candidateId, createdAt])
  // The expiry job.
  @@index([status, expiresAt])
  // The weekly second look: passes of a certain age.
  @@index([status, updatedAt])
}

enum SparkStatus {
  PENDING
  MATCHED
}

// "I'd like to work with you", with a reason. Two sparks that answer each other (the second one's type is the counterpart of the first's) make a
// Match. `connectionType` is the SENDER's side of the relationship. Sparks pay no XP.
model Spark {
  id             String      @id @default(cuid())
  fromId         String
  toId           String
  dropId         String?
  connectionType MatchType
  // 20 to 280 characters the sender wrote; what the receiver sees (if their plan shows it).
  opener         String
  // A fingerprint of the opener's words, to notice the same message going to many people.
  openerHash     String
  status         SparkStatus @default(PENDING)
  createdAt      DateTime    @default(now())

  from User  @relation("SparksSent", fields: [fromId], references: [id], onDelete: Cascade)
  to   User  @relation("SparksReceived", fields: [toId], references: [id], onDelete: Cascade)
  drop Drop? @relation(fields: [dropId], references: [id], onDelete: SetNull)

  // One spark from a person to another per type of relationship.
  @@unique([fromId, toId, connectionType])
  // The received list, newest first.
  @@index([toId, status, createdAt])
  // The daily digest: who was sparked lately and is still waiting.
  @@index([status, createdAt])
  // How many a person sent today, and their recent openers.
  @@index([fromId, createdAt])
  // The same opener sent again.
  @@index([openerHash, createdAt])
}

enum MatchEndReason {
  UNMATCHED
  REPORTED
  BLOCKED
}

// Two people who sparked each other. userAId is always the smaller id, so a pair is one row whichever of them sparked first (the check constraint
// in the migration keeps it so); connectionType names the relationship the same from both sides (a mentor and a mentee are a MENTOR match).
model Match {
  id             String          @id @default(cuid())
  userAId        String
  userBId        String
  userARole      MatchType
  userBRole      MatchType
  connectionType MatchType
  conversationId String?         @unique
  createdAt      DateTime        @default(now())
  // Unmatching is final: once set, the pair is never matched, dropped to each other or sparked again.
  endedAt        DateTime?
  endedById      String?
  endReason      MatchEndReason?

  userA         User           @relation("MatchesAsA", fields: [userAId], references: [id], onDelete: Cascade)
  userB         User           @relation("MatchesAsB", fields: [userBId], references: [id], onDelete: Cascade)
  conversation  Conversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  // Romance matches only (connectionType DATING): the photo reveal and the Phase 2 Build Dates.
  revealRequest RevealRequest?
  buildDates    BuildDate[]

  @@unique([userAId, userBId, connectionType])
  @@index([userBId, endedAt])
  @@index([userAId, endedAt])
}

enum MediaPurpose {
  POST_MEDIA
  ROMANCE_PHOTO
}

enum MediaKind {
  IMAGE
  GIF
  VIDEO
}

enum MediaStatus {
  // Declared and a presigned upload issued; the object has not been checked yet.
  PENDING
  // Uploaded, and its real size and type matched the declaration.
  READY
  // Uploaded but not what was declared; the object is deleted.
  REJECTED
}

// A file a person uploaded or is about to (src/lib/media-assets.ts). The server never receives the bytes: it checks a declaration (type, size, dimensions, hash),
// signs an upload straight to the bucket, and then looks at the real object. `key` is where it lives in the bucket; (ownerId, purpose, sha256) is unique, which
// is the content-hash dedupe: uploading the same file twice is one object.
model MediaAsset {
  id          String       @id @default(cuid())
  ownerId     String
  purpose     MediaPurpose
  kind        MediaKind
  key         String       @unique
  contentType String
  bytes       Int
  width       Int
  height      Int
  durationMs  Int?
  sha256      String
  status      MediaStatus  @default(PENDING)
  createdAt   DateTime     @default(now())
  confirmedAt DateTime?

  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  romancePhoto RomancePhoto?

  @@unique([ownerId, purpose, sha256])
  // A person's unfinished uploads, and the cleanup of abandoned ones.
  @@index([ownerId, status])
  @@index([status, createdAt])
}

// --- The romance mode (src/lib/romance, docs/ROMANCE.md) ----------------------------------------------------------
// Its tables are its own: nothing in the professional model (MatchingProfile, Drop) holds a romance fact. The storage key of the old model stays `DATING`
// (the MatchType and ConnectionType value, and the Match rows made with it); the mode's name is not final and is never stored.

enum RomanceGender {
  WOMAN
  MAN
  NON_BINARY
  // Described in the person's own words (RomanceProfile.genderSelfDescribe). Also what "interested in" says for people who describe themselves another way.
  SELF_DESCRIBED
}

enum RomanceScope {
  CITY
  COUNTRY
  ANYWHERE
}

// A person's romance profile. 1:1 with User, created by opting in (PUT /api/romance/profile, behind the 18+ gate). The first half is what a match sees; the
// PRIVATE FILTERS below it are returned to the owner and to nobody else, and only ever decide who is shown to whom.
model RomanceProfile {
  id                 String          @id @default(cuid())
  userId             String          @unique
  promptObsessed     String          @db.Text
  promptBuild        String          @db.Text
  promptWeekend      String          @db.Text
  // 1 to 4 (src/lib/romance/config.ts AMBITION_LEVELS).
  ambition           Int
  direction          String
  rhythm             String
  obsessions         String[]        @default([])
  // --- private filters ---
  gender             RomanceGender
  genderSelfDescribe String?
  interestedIn       RomanceGender[]
  ageMin             Int
  ageMax             Int
  scope              RomanceScope    @default(COUNTRY)
  // "Only people endorsed by at least this many builders can spark me": 0 to 5.
  minEndorsements    Int             @default(0)
  paused             Boolean         @default(false)
  // The ISO week ("2026-W43", in their zone then) the weekly drop was last made for, so a week is made once.
  lastDropWeek       String?
  // The local date ("YYYY-MM-DD") of the last time a drop was looked for and none was found, so an empty week is looked at once a day and not every hour.
  lastDropTryDate    String?
  // When the daily "N people sparked you in <the mode>" notification was last sent (the romance counterpart of MatchingProfile.sparkDigestAt).
  sparkDigestAt      DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos RomancePhoto[]

  @@index([paused, gender])
  @@index([interestedIn], type: Gin)
}

// A photo is stored, and returned to its owner; anyone else gets a blurred placeholder until the two have revealed to each other (src/lib/romance/reveal.ts).
model RomancePhoto {
  id        String   @id @default(cuid())
  profileId String
  assetId   String   @unique
  // Where it is in the owner's order, from 0.
  position  Int
  // A BlurHash the client computed, shown in place of the photo to anybody who may not see it yet.
  blurHash  String?
  createdAt DateTime @default(now())

  profile RomanceProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  asset   MediaAsset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([profileId, position])
}

// The ONE person a person is shown each week (src/lib/romance/drops.ts). `weekKey` is the ISO week in the viewer's zone, so (userId, weekKey) unique is "one a week".
model RomanceDrop {
  id          String     @id @default(cuid())
  userId      String
  candidateId String
  // 0 to 100, from scoreRomance(), and the (at most three) lines that explain it.
  score       Int
  reasons     Json       @default("[]")
  weekKey     String
  status      DropStatus @default(NEW)
  // The end of the viewer's local week.
  expiresAt   DateTime
  viewedAt    DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user      User @relation("RomanceDropsReceived", fields: [userId], references: [id], onDelete: Cascade)
  candidate User @relation("RomanceDropsShown", fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([userId, weekKey])
  // "Was this person shown to this viewer lately".
  @@index([userId, candidateId, createdAt])
  // How often a candidate has been shown this week (the exposure cap).
  @@index([candidateId, createdAt])
  @@index([status, expiresAt])
}

enum RevealStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
}

// Photos are shown to the other person of a romance match only when BOTH have agreed (src/lib/romance/reveal.ts). One row per match: the request, who made it, and where it
// stands. Either person can revoke an accepted reveal at any time, and ending the match revokes it. `buildDateId` is for Phase 2: a Build Date (the first date as a
// micro-collab) that unlocks the reveal; nothing writes it yet.
model RevealRequest {
  id          String       @id @default(cuid())
  matchId     String       @unique
  requesterId String
  status      RevealStatus @default(PENDING)
  buildDateId String?      @unique
  respondedAt DateTime?
  revokedAt   DateTime?
  revokedById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  match     Match      @relation(fields: [matchId], references: [id], onDelete: Cascade)
  buildDate BuildDate? @relation(fields: [buildDateId], references: [id], onDelete: SetNull)
}

enum BuildDateStatus {
  PROPOSED
  ACCEPTED
  COMPLETED
  CANCELLED
}

// PHASE 2 STUB. A Build Date is the first date as a small collaboration. Only the model and its statuses exist, so that the reveal flow can key off a completed one later;
// no route reads or writes it yet.
model BuildDate {
  id           String          @id @default(cuid())
  matchId      String
  proposedById String
  status       BuildDateStatus @default(PROPOSED)
  scheduledFor DateTime?
  completedAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  match  Match          @relation(fields: [matchId], references: [id], onDelete: Cascade)
  reveal RevealRequest?

  @@index([matchId])
}

enum DuoStatus {
  PENDING
  ACTIVE
  DISSOLVED
}

// Two people who agreed to share a page (src/lib/romance/duo.ts): their joint projects and a combined heatmap. Both must consent (one asks, the other accepts) and either can
// dissolve it. userAId is always the smaller id, so a pair is one row (a check constraint in the migration keeps it so).
model Duo {
  id            String    @id @default(cuid())
  userAId       String
  userBId       String
  requestedById String
  status        DuoStatus @default(PENDING)
  acceptedAt    DateTime?
  dissolvedAt   DateTime?
  dissolvedById String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  userA User @relation("DuoAsA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("DuoAsB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userBId, status])
  @@index([userAId, status])
}

// --- Ship posts and the feed (src/lib/posts, src/lib/feed, docs/FEED.md) --------------------------------------------------

enum PostKind {
  SHIP
  UPDATE
  DEVLOG
  DEMO
}

enum PostVisibility {
  PUBLIC
  FOLLOWERS
  CREW
}

// Something a builder shows: a ship, an update, a devlog or a demo. Body is Markdown, sanitised on the way in. `media` is [{ assetId, key, type, width, height, durationMs }] from the
// author's own confirmed uploads. Deleting is soft. `propsScore` is the sum of the weights of its Props (denormalised, updated in the same transaction as the Prop).
model ShipPost {
  id              String         @id @default(cuid())
  authorId        String
  projectId       String?
  teamId          String?
  kind            PostKind
  title           String
  body            String         @db.Text
  links           String[]       @default([])
  media           Json           @default("[]")
  stackTags       String[]       @default([])
  // Other members of the project or crew who share the credit.
  coAuthorIds     String[]       @default([])
  visibility      PostVisibility @default(PUBLIC)
  // The author's local Friday ("YYYY-MM-DD") when the post was made on Ship Day, else null.
  shipDayKey      String?
  propsScore      Float          @default(0)
  propsCount      Int            @default(0)
  commentCount    Int            @default(0)
  // How many times it was edited (a lightweight revision count).
  revision        Int            @default(0)
  // The ProjectUpdate an UPDATE or DEVLOG post counted as, which carries the existing XP and caps.
  projectUpdateId String?
  createdAt       DateTime       @default(now())
  editedAt        DateTime?
  deletedAt       DateTime?

  author   User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  project  Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  props    Prop[]
  comments Comment[]

  @@index([authorId, createdAt])
  @@index([projectId, createdAt])
  @@index([teamId, createdAt])
  @@index([createdAt])
  @@index([shipDayKey])
  @@index([coAuthorIds], type: Gin)
}

// One builder's respect for one post. Unique per pair. `weight` is fixed when it is given (src/lib/posts/props-weight.ts); 0 for a giver the trust gate does not trust.
model Prop {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  weight    Float
  createdAt DateTime @default(now())

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post ShipPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId, createdAt])
  @@index([userId, createdAt])
}

// One level of threading: a reply's parent is always a top-level comment. Deleting is soft (the thread keeps its shape). Editable for a short window.
model Comment {
  id        String    @id @default(cuid())
  postId    String
  authorId  String
  parentId  String?
  body      String    @db.Text
  editedAt  DateTime?
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  post    ShipPost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("Replies")

  @@index([postId, createdAt])
  @@index([parentId, createdAt])
}

model Follow {
  id         String   @id @default(cuid())
  followerId String
  followeeId String
  createdAt  DateTime @default(now())

  follower User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  followee User @relation("Followers", fields: [followeeId], references: [id], onDelete: Cascade)

  @@unique([followerId, followeeId])
  @@index([followeeId, createdAt])
}

// A user watching a project: posts on it reach them (src/lib/posts/watch.ts).
model Watch {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([projectId])
}

// Something that looks off and is worth a person's eye later, recorded and never acted on by itself (for example a burst of Props from new accounts).
model IntegritySignal {
  id          String   @id @default(cuid())
  kind        String
  userId      String?
  subjectType String
  subjectId   String
  data        Json     @default("{}")
  createdAt   DateTime @default(now())

  @@index([kind, createdAt])
  @@index([subjectType, subjectId])
}

// The Saturday recap of a Ship Day (src/lib/posts/ship-day-recap.ts): one row per ISO week.
model ShipDayRecap {
  id         String   @id @default(cuid())
  weekKey    String   @unique
  dateKey    String
  totalPosts Int
  // [{ postId, authorId, propsScore, title }] best first.
  topPosts   Json     @default("[]")
  // { countries: [{ code, count }], cities: [{ key, count }], campuses: [{ key, count }] }
  places     Json     @default("{}")
  createdAt  DateTime @default(now())
}
